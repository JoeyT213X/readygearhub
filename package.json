{
  "name": "readygearhub",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-schema.mjs && node scripts/check-directory.mjs",
    "preview": "astro preview",
    "check-links": "node scripts/check-links.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test:paid-guard": "node packages/catalog/paid-guard.test.mjs",
    "catalog:build": "esbuild packages/catalog/index.ts --bundle --format=esm --platform=neutral --outfile=packages/catalog/dist/index.mjs",
    "images:manifest": "node scripts/image-manifest.mjs",
    "prices:update": "node scripts/price-feed.mjs",
    "prices:priority": "node scripts/price-priority.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@netlify/blobs": "^11.1.9",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "rolldown": "1.2.19"
  }
}
