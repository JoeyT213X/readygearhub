---
// Pay-per-lead boxes from src/data/affiliates.ts. Renders nothing until a lead program is approved.
import { leadCtasFor } from '../data/affiliates';
interface Props { place: string }
const ctas = leadCtasFor(Astro.props.place);
---
{ctas.length > 0 && (
  <section class="wrap section lead-ctas" aria-label="Sponsored offers">
    {ctas.map((c) => (
      <div class="card lead-cta">
        <h2>{c.title}</h2>
        <p>{c.blurb}</p>
        <a class="btn" href={c.url} target="_blank" rel="sponsored nofollow noopener" data-program={c.id}>{c.button} ↗</a>
        <p class="fine">Sponsored: ReadyGearHub may be paid by {c.name} when you request a quote. <a href="/affiliate-disclosure/">Disclosure</a></p>
      </div>
    ))}
  </section>
)}
