---
import Photo from './Photo.astro';
import { photoForGuide } from '../data/images';
interface Props { guide: { id: string; data: { title: string; description: string; lane?: string } }; laneName?: string; size?: 'normal' | 'large' | 'row' }
const { guide, laneName, size = 'normal' } = Astro.props;
---
<article class:list={['card', 'media-card', 'guide-card', `size-${size}`]}>
  <a class="media-card-img" href={`/guides/${guide.id}/`} tabindex="-1" aria-hidden="true">
    <Photo name={photoForGuide(guide.id, guide.data.lane)} decorative sizes={size === 'large' ? '(min-width: 980px) 60vw, 100vw' : '(min-width: 980px) 33vw, (min-width: 640px) 50vw, 100vw'} />
  </a>
  <div class="media-card-body">
    {laneName && <p class="kicker">{laneName}</p>}
    <h3><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3>
    <p>{guide.data.description}</p>
    <a class="text-link" href={`/guides/${guide.id}/`} aria-hidden="true" tabindex="-1">Read the guide →</a>
  </div>
</article>
