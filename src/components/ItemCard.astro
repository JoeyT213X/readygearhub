---
import { laneBySlug, outUrl, isAffiliate, programIdForItem, getGuides, type Item } from '../lib/data';
import { isNoPpcProgram } from '../data/affiliates';
import { productPhotoFor, photoBackdropClass } from '../data/product-photos';
interface Props { item: Item; showRank?: boolean; showGuide?: boolean }
const { item, showRank = false, showGuide = true } = Astro.props;
const guide = showGuide ? (await getGuides()).find((g) => g.data.relatedItems.includes(item.id)) : undefined;
const lane = laneBySlug(item.data.lane);
const program = programIdForItem(item.id);
const photo = productPhotoFor({ id: item.id });
const backdrop = photo ? photoBackdropClass({ id: item.id, name: item.data.name, brand: item.data.brand, tags: item.data.tags }) : '';
---
<article class="card item-card" data-no-ppc={isNoPpcProgram(program) ? '' : undefined}>
  {photo && (
    <a class={`item-card-photo ${backdrop}`} href={`/gear/${item.id}/`} tabindex="-1" aria-hidden="true">
      <img src={photo.src} srcset={photo.srcset} sizes="(min-width: 900px) 330px, 92vw" alt="" width="960" height="540" loading="lazy" decoding="async" />
    </a>
  )}
  <div class="card-top">
    {lane && <a class="pill" href={`/${lane.slug}/`}>{lane.icon} {lane.name}</a>}
    {showRank && item.data.rank > 0 && <span class="pill hot">🔥 Trending</span>}
    {item.data.featured && <span class="pill feat">⭐ Featured</span>}
  </div>
  <h3><a href={`/gear/${item.id}/`}>{item.data.name}</a></h3>
  <p class="brand">{item.data.brand}</p>
  <p>{item.data.description}</p>
  {item.data.uses.length > 0 && <p class="uses"><strong>Also good for:</strong> {item.data.uses.slice(0, 2).join(' · ')}</p>}
  {guide && <p class="card-guide-link">📘 How it fits: <a href={`/guides/${guide.id}/`}>{guide.data.title}</a></p>}
  <div class="card-actions">
    <a class="btn small ghost" href={`/gear/${item.id}/`}>Details</a>
    <a class="btn small" href={outUrl(item)} target="_blank" rel={isAffiliate(item) ? 'sponsored nofollow noopener' : 'noopener'} data-program={isAffiliate(item) && program ? program : undefined}>Check current price ↗</a>
  </div>
</article>
