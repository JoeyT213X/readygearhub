---
import { laneBySlug, outUrl, isAffiliate, programIdForItem, type Item } from '../lib/data';
import { isNoPpcProgram } from '../data/affiliates';
interface Props { item: Item; showRank?: boolean }
const { item, showRank = false } = Astro.props;
const lane = laneBySlug(item.data.lane);
const program = programIdForItem(item.id);
---
<article class="card item-card" data-no-ppc={isNoPpcProgram(program) ? '' : undefined}>
  <div class="card-top">
    {lane && <a class="pill" href={`/${lane.slug}/`}>{lane.icon} {lane.name}</a>}
    {showRank && item.data.rank > 0 && <span class="pill hot">🔥 Trending</span>}
    {item.data.featured && <span class="pill feat">⭐ Featured</span>}
  </div>
  <h3><a href={`/gear/${item.id}/`}>{item.data.name}</a></h3>
  <p class="brand">{item.data.brand}</p>
  <p>{item.data.description}</p>
  {item.data.uses.length > 0 && <p class="uses"><strong>Also good for:</strong> {item.data.uses.slice(0, 2).join(' · ')}</p>}
  <div class="card-actions">
    <a class="btn small ghost" href={`/gear/${item.id}/`}>Details</a>
    <a class="btn small" href={outUrl(item)} target="_blank" rel={isAffiliate(item) ? 'sponsored nofollow noopener' : 'noopener'} data-program={isAffiliate(item) && program ? program : undefined}>Check current price ↗</a>
  </div>
</article>
