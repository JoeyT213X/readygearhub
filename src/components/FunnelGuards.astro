---
/**
 * Two small sitewide scripts, both inline and dependency-free.
 *
 * 1. Paid-ad session guard (rgh_paid_search).
 *    If a visit lands with a Google Ads click ID (gclid / gbraid / wbraid) or
 *    utm_medium=cpc|ppc|paid..., sessionStorage.rgh_paid_search = '1' is set.
 *    For the rest of that browser session, every no-PPC program element
 *    (Choice Home Warranty, REDI, Waterdrop Filter, TideWe, and Bogs — via data-program,
 *    data-no-ppc, data-chw, or a matching official / tracking URL) is hidden
 *    by CSS immediately and then removed together with its wrapper (lead box,
 *    directory card, list item, or paragraph) so no empty box is left behind.
 *    These programs do not allow paid-search promotion, so paid visitors never
 *    see them. Ordinary organic visits are unchanged and still show the links.
 *
 * 2. MailerLite signup hook.
 *    Watches for the PTvH32 success panel (.ml-form-successBody) to become
 *    visible. MailerLite's own JSONP submit runs untouched; only after it
 *    succeeds do we send GA4 generate_lead and move the reader to
 *    /thank-you/?src=<page-slug> (600 ms later), where the printable guide is.
 */
import { analytics } from '../data/analytics';
import { mailerlite } from '../data/mailerlite';
import { noPpcProgramIds } from '../data/affiliates';
const NO_PPC_PROGRAM_IDS = noPpcProgramIds();

const NO_PPC_LINK_MARKERS = [
  'click-101929817-12337172',
  'choicehomewarranty.com',
  'getredi.com',
  'getredi.goaffpro',
  'waterdropfilter.com',
  'offerid=1888875',
  'tidewe.com',
  'awinmid=78182',
  'bogsfootwear.com',
  'mid=37142',
];

const noPpcSel = ['[data-no-ppc]', '[data-chw]', '[data-chw-wrap]', ...NO_PPC_PROGRAM_IDS.map((id) => `[data-program="${id}"]`)].join(',');
const noPpcCssSel = noPpcSel.split(',').map((s) => `html.rgh-paid ${s}`).join(',');

const guardJs = `(function(){try{var q=location.search||'';var paid=/[?&](gclid|gbraid|wbraid)=/i.test(q)||/[?&]utm_medium=(cpc|ppc|paid|paidsearch|paid_search|paid-search|paid_social)(&|$)/i.test(q);if(paid)sessionStorage.setItem('rgh_paid_search','1');if(sessionStorage.getItem('rgh_paid_search')!=='1')return;var d=document.documentElement;d.classList.add('rgh-paid');var markers=${JSON.stringify(NO_PPC_LINK_MARKERS)};var sel=${JSON.stringify(noPpcSel)};function sweep(){var list=[].slice.call(document.querySelectorAll(sel));[].slice.call(document.querySelectorAll('a[href]')).forEach(function(a){var h=(a.getAttribute('href')||'').toLowerCase();for(var i=0;i<markers.length;i++){if(h.indexOf(markers[i])!==-1){list.push(a);break;}}});list.forEach(function(el){var w=el.closest('[data-no-ppc],[data-chw-wrap],.lead-cta,.item-card,li,p,blockquote')||el;if(w.parentNode)w.parentNode.removeChild(w);});[].slice.call(document.querySelectorAll('[data-no-ppc],[data-chw-wrap],[data-chw]')).forEach(function(w){if(w.parentNode)w.parentNode.removeChild(w);});[].slice.call(document.querySelectorAll('.lead-ctas')).forEach(function(s){if(!s.querySelector('.lead-cta'))s.parentNode&&s.parentNode.removeChild(s);});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',sweep);}else{sweep();}window.addEventListener('load',sweep);}catch(e){}})();`;

const guardCss = `${noPpcCssSel}{display:none!important}`;

const ga4On = /^G-[A-Z0-9]+$/i.test(analytics.ga4Id.trim());
const signupJs = mailerlite.enabled
  ? `(function(){if(location.pathname.indexOf('/thank-you')===0)return;var sent=false;function slug(){var p=location.pathname.replace(/^\\/+|\\/+$/g,'');return p?p.replace(/\\//g,'-'):'home';}function visible(el){if(!el)return false;var s=window.getComputedStyle(el);return s.display!=='none'&&s.visibility!=='hidden'&&el.offsetHeight>0;}function success(){if(sent)return;sent=true;var src=slug();try{sessionStorage.setItem('rgh_signup_pending',src);}catch(e){}if(${ga4On ? 'true' : 'false'}&&typeof gtag==='function'){gtag('event','generate_lead',{method:'mailerlite',form_id:'${mailerlite.form}',signup_source:src,page_path:location.pathname,transport_type:'beacon'});}setTimeout(function(){location.href='/thank-you/?src='+encodeURIComponent(src);},600);}function check(){var b=document.querySelectorAll('.ml-embedded .ml-form-successBody, .ml-form-embedContainer .ml-form-successBody');for(var i=0;i<b.length;i++){if(visible(b[i])){success();return true;}}return false;}function start(){if(!window.MutationObserver)return;var mo=new MutationObserver(function(){if(!sent)check();});mo.observe(document.body,{subtree:true,childList:true,attributes:true,attributeFilter:['style','class']});document.addEventListener('submit',function(e){var f=e.target;if(!f||!f.closest||!f.closest('.ml-embedded,.ml-form-embedContainer'))return;var n=0;var t=setInterval(function(){n++;if(check()||n>120)clearInterval(t);},250);},true);}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',start);}else{start();}})();`
  : '';
---
<style is:inline set:html={guardCss}></style>
<script is:inline set:html={guardJs}></script>
{signupJs && <script is:inline set:html={signupJs}></script>}
