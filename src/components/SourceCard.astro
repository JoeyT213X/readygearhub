---
import type { CatalogItem } from '../data/full-catalog';
import { stockCoverFor } from '../data/stock-covers';
import { productPhotoFor, photoBackdropClass } from '../data/product-photos';
import { listingAction } from '../data/listing-actions';
interface Props { item: CatalogItem; heading?: 'h2' | 'h3' }
const { item, heading = 'h3' } = Astro.props;
const action = listingAction(item);
const product = productPhotoFor(item);
const stock = product ? undefined : stockCoverFor(item);
const Tag = heading;
const titleHref = item.detailHref || item.href;
const ctaHref = item.href;
const titleInternal = titleHref.startsWith('/');
const ctaInternal = ctaHref.startsWith('/');
const titleRel = titleInternal ? undefined : (item.rel || undefined);
const ctaRel = ctaInternal ? undefined : (item.rel || undefined);
const backdrop = (product || item.imageKind === 'photo') ? photoBackdropClass(item) : '';
const coverClass = [
  product || item.imageKind === 'photo' ? ' is-photo' : !stock && item.imageKind ? ` is-${item.imageKind}` : '',
  stock ? ' is-stock' : product || item.image ? '' : ' is-text',
  item.kind === 'tool' ? ' is-free' : '',
  backdrop ? ` ${backdrop}` : '',
].join('');
const sourceFilter = item.kind === 'resource' ? 'official' : item.kind === 'tool' ? 'rgh-tools' : item.programId;
const badge = item.trending
  ? 'Trending'
  : item.offerLabel === 'Instant PDF'
    ? 'Instant PDF'
    : item.kind === 'tool'
      ? 'Free'
      : item.kind === 'resource'
        ? 'Free resource'
        : undefined;
---
<article
  id={item.id}
  class={`card item-card product-card source-card${coverClass}${item.filler ? ' is-filler' : ''}`}
  data-program={item.affiliate && item.programId ? item.programId : undefined}
  data-no-ppc={item.hideOnPaid ? '' : undefined}
  data-category={item.category}
  data-also={(item.alsoIn ?? []).join(' ')}
  data-source={sourceFilter || undefined}
  data-kind={item.kind}
  data-trending={item.trending ? '1' : undefined}
  data-groups={item.groups.join(' ') || undefined}
>
  <a class="product-cover" href={titleHref} aria-label={item.title} tabindex="-1" target={titleInternal ? undefined : '_blank'} rel={titleRel}>
    {badge && <span class="badge">{badge}</span>}
    {product ? (
      <img src={product.src} srcset={product.srcset} sizes="(min-width: 900px) 330px, (min-width: 600px) 45vw, 92vw" alt={product.alt} width="960" height="540" loading="lazy" decoding="async" class="source-fit" />
    ) : stock ? (
      <>
        <img src={stock.src} srcset={stock.srcset} sizes="(min-width: 900px) 330px, (min-width: 600px) 45vw, 92vw" alt={stock.alt} width="960" height="540" loading="lazy" decoding="async" class="stock-photo" />
        <span class="stock-chip">Representative photo</span>
      </>
    ) : item.image ? (
      <img src={item.image} alt="" width="640" height="360" loading="lazy" decoding="async" class={item.imageKind ? 'source-fit' : undefined} />
    ) : (
      <span class="source-cover-label">
        <span class="source-cover-kicker">{item.sourceName}</span>
        <span class="source-cover-title">{item.title}</span>
      </span>
    )}
  </a>
  <p class="product-meta">{item.sourceName}{item.offerLabel ? ` · ${item.offerLabel}` : ''}{item.usBadge && <span class="us-chip" title="U.S.-based maker"><svg viewBox="0 0 16 12" width="13" height="10" aria-hidden="true" focusable="false"><rect width="16" height="12" rx="1.2" fill="#b22234"/><rect y="2.4" width="16" height="2.4" fill="#f7f3ea"/><rect y="7.2" width="16" height="2.4" fill="#f7f3ea"/><rect width="7.2" height="6.4" fill="#1f3a5f"/></svg>U.S.</span>}</p>
  <Tag><a href={titleHref} target={titleInternal ? undefined : '_blank'} rel={titleRel}>{item.title}</a></Tag>
  <p class="product-price">{item.priceLabel}</p>
  <p>{item.blurb}</p>
  <div class="card-actions">
    <a
      class="btn small"
      href={ctaHref}
      target={ctaInternal ? undefined : '_blank'}
      rel={ctaRel}
      data-program={item.affiliate && item.programId ? item.programId : undefined}
    >{action.label}{ctaInternal ? '' : ' ↗'}</a>
    {action.code && <p class="listing-code">Code: <strong>{action.code}</strong></p>}
  </div>
</article>

<style>
  .us-chip{display:inline-flex;align-items:center;gap:4px;margin-left:8px;padding:1px 7px 1px 5px;border-radius:999px;background:#1f3a5f;color:#f7f3ea;font-size:.68rem;font-weight:700;letter-spacing:.04em;vertical-align:middle;line-height:1.5}
</style>
