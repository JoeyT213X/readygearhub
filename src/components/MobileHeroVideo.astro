---
/**
 * Phones only (768px and under): a short muted looping background video behind the badge and tagline
 * at the top of the home hero. Sits inside the shop-board copy block, so the 15-tile category grid still fits the first screen.
 * - Hidden on wider screens; nothing is downloaded there (the poster is a CSS background inside the phone media query).
 * - The video file is not requested until the page has loaded and the browser is idle. It is skipped entirely for
 *   prefers-reduced-motion, Save-Data and 2G/slow connections, and the poster stays as the still.
 * - Paused when scrolled out of view or the tab is hidden. 8.8 s, about 1.1 MB, no audio, our own generated imagery
 *   (no people, no logos or readable text).
 */
---
<div class="mx-hero-bg" data-mx-hero aria-hidden="true">
  <video class="mx-hero-video" muted loop playsinline autoplay preload="none" tabindex="-1" disablepictureinpicture data-src="/videos/mobile-extreme-hero.mp4"></video>
  <span class="mx-hero-shade"></span>
</div>
<p class="mx-hero-tag">Storms. Outages. Off-grid.<br />Be ready.</p>
<script is:inline>
  (function () {
    var box = document.querySelector('[data-mx-hero]');
    if (!box || !window.matchMedia) return;
    var phone = window.matchMedia('(max-width: 768px)');
    if (!phone.matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var c = navigator.connection || {};
    if (c.saveData === true || /(^|-)2g$/.test(c.effectiveType || '')) return;
    var v = box.querySelector('video');
    var started = false;
    var start = function () {
      if (started) return;
      started = true;
      v.addEventListener('playing', function () { box.classList.add('is-playing'); }, { once: true });
      v.src = v.getAttribute('data-src');
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { v.play().catch(function () {}); } else { v.pause(); } });
        }, { threshold: 0.05 }).observe(box);
      }
      document.addEventListener('visibilitychange', function () { if (document.hidden) v.pause(); else v.play().catch(function () {}); });
    };
    var later = function () { if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 }); else setTimeout(start, 800); };
    if (document.readyState === 'complete') later(); else window.addEventListener('load', later, { once: true });
  })();
</script>
<style is:global>
  .mx-hero-bg,.mx-hero-tag{display:none}
  @media (max-width: 768px) {
    .home-shop-hero .shop-board-copy.has-mx-hero{
      position:relative;
      isolation:isolate;
      flex-direction:column;
      align-items:flex-start;
      justify-content:space-between;
      gap:0;
      min-height:clamp(128px,21svh,184px);
      padding:9px 12px 11px;
      border-radius:12px;
      overflow:hidden;
      border:1px solid rgba(217,178,79,.55);
      box-shadow:0 4px 14px rgba(0,0,0,.38);
    }
    .mx-hero-bg{
      display:block;
      position:absolute;
      inset:0;
      z-index:-1;
      background:#0e1626 url('/videos/mobile-extreme-poster.jpg') center 68%/cover no-repeat;
    }
    .mx-hero-video{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center 68%;
      opacity:0;
      transition:opacity .5s ease;
    }
    .mx-hero-bg.is-playing .mx-hero-video{opacity:1}
    /* Dark gradient keeps the badge and tagline readable over the busiest frames. */
    .mx-hero-shade{
      position:absolute;
      inset:0;
      background:linear-gradient(180deg,rgba(8,14,26,.62) 0%,rgba(8,14,26,.30) 42%,rgba(8,14,26,.78) 100%);
    }
    .mx-hero-tag{
      order:2;
      text-wrap:balance;
      display:block;
      margin:0;
      font:800 clamp(1.05rem,5vw,1.4rem)/1.15 var(--font-display,Georgia,serif);
      letter-spacing:.01em;
      color:#fff;
      text-shadow:0 2px 14px rgba(0,0,0,.95),0 0 3px rgba(0,0,0,.9);
    }
    /* Keep the 15-tile grid on one screen: it gives up the height the video banner takes. */
    .home-shop-hero .shop-board:has(.has-mx-hero) .shop-board-grid{
      height:max(504px,calc(100svh - 95px - 6px - clamp(128px,21svh,184px) - 14px));
      max-height:none;
    }
  }
  @media (prefers-reduced-motion: reduce){ .mx-hero-video{display:none} }
</style>
