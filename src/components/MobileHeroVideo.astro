---
/**
 * Phones only (768px and under): a full-screen muted looping background video is the home hero (about 100svh minus the
 * site header), with the badge at the top and a tagline plus four buttons over it. The 15-tile category grid starts below the fold.
 * - Hidden on wider screens; nothing is downloaded there (the poster is a CSS background inside the phone media query).
 * - The video file is not requested until the page has loaded and the browser is idle. It is skipped entirely for
 *   prefers-reduced-motion, Save-Data and 2G/slow connections, and the poster stays as the still.
 * - Paused when scrolled out of view or the tab is hidden. 9.2 s, about 1.6 MB, no audio, our own generated imagery
 *   (no people, no logos or readable text).
 */
---
<div class="mx-hero-bg" data-mx-hero aria-hidden="true">
  <video class="mx-hero-video" muted loop playsinline autoplay preload="none" tabindex="-1" disablepictureinpicture data-src="/videos/mobile-extreme-hero.mp4"></video>
  <span class="mx-hero-shade"></span>
</div>
<p class="mx-hero-tag">Storms. Outages. Off-grid.<br />Be ready.</p>
<nav class="mx-hero-cta" aria-label="Start here">
  <a class="mx-cta is-primary" href="/directory/">Shop gear</a>
  <a class="mx-cta" href="/doomsday-prepper/">Doomsday prep</a>
  <a class="mx-cta" href="/winter-deals/">Winter deals</a>
  <a class="mx-cta" href="/guides/">Read the guides</a>
</nav>
<script is:inline>
  (function () {
    var box = document.querySelector('[data-mx-hero]');
    if (!box || !window.matchMedia) return;
    var phone = window.matchMedia('(max-width: 768px)');
    if (!phone.matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var c = navigator.connection || {};
    if (c.saveData === true || /(^|-)2g$/.test(c.effectiveType || '')) return;
    var v = box.querySelector('video');
    var started = false;
    var start = function () {
      if (started) return;
      started = true;
      v.addEventListener('playing', function () { box.classList.add('is-playing'); }, { once: true });
      v.src = v.getAttribute('data-src');
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { v.play().catch(function () {}); } else { v.pause(); } });
        }, { threshold: 0.05 }).observe(box);
      }
      document.addEventListener('visibilitychange', function () { if (document.hidden) v.pause(); else v.play().catch(function () {}); });
    };
    var later = function () { if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 }); else setTimeout(start, 800); };
    if (document.readyState === 'complete') later(); else window.addEventListener('load', later, { once: true });
  })();
</script>
<style is:global>
  .mx-hero-bg,.mx-hero-tag,.mx-hero-cta{display:none}
  @media (max-width: 768px) {
    .home-shop-hero .shop-board-copy.has-mx-hero{
      position:relative;
      isolation:isolate;
      flex-direction:column;
      align-items:stretch;
      justify-content:flex-start;
      gap:0;
      /* Almost the whole first screen: viewport minus the 95px header and a small peek of the tiles below. */
      height:max(480px,calc(100svh - 95px - 26px));
      min-height:480px;
      padding:12px 14px 16px;
      border-radius:14px;
      overflow:hidden;
      border:1px solid rgba(217,178,79,.55);
      box-shadow:0 6px 18px rgba(0,0,0,.45);
    }
    .home-shop-hero .shop-board-copy.has-mx-hero .shop-board-topline{order:0;align-self:flex-start}
    .mx-hero-bg{
      display:block;
      position:absolute;
      inset:0;
      z-index:-1;
      background:#0e1626 url('/videos/mobile-extreme-poster.jpg') center center/cover no-repeat;
    }
    .mx-hero-video{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center center;
      opacity:0;
      transition:opacity .5s ease;
    }
    .mx-hero-bg.is-playing .mx-hero-video{opacity:1}
    /* Dark gradient: strong under the badge and under the tagline and buttons, lighter in the middle so the shots still show. */
    .mx-hero-shade{
      position:absolute;
      inset:0;
      background:linear-gradient(180deg,rgba(8,14,26,.66) 0%,rgba(8,14,26,.18) 30%,rgba(8,14,26,.22) 50%,rgba(8,14,26,.80) 76%,rgba(8,14,26,.94) 100%);
    }
    .mx-hero-tag{
      order:2;
      display:block;
      margin:auto 0 14px;
      text-wrap:balance;
      font:800 clamp(1.3rem,6.2vw,1.75rem)/1.1 var(--font-display,Georgia,serif);
      letter-spacing:.005em;
      color:#fff;
      text-shadow:0 2px 16px rgba(0,0,0,.95),0 0 3px rgba(0,0,0,.9);
    }
    .mx-hero-cta{
      order:3;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
    }
    .mx-cta{
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:46px;
      padding:8px 10px;
      border-radius:8px;
      border:1px solid rgba(224,182,79,.75);
      background:rgba(10,20,34,.72);
      color:#fff;
      font:700 .98rem/1.1 var(--font-sans,system-ui);
      text-align:center;
      text-decoration:none;
      text-shadow:0 1px 3px rgba(0,0,0,.8);
      -webkit-backdrop-filter:blur(3px);
      backdrop-filter:blur(3px);
    }
    .mx-cta.is-primary{background:#b22234;border-color:#e0b64f}
    .mx-cta:active,.mx-cta:focus-visible{background:#c92b40;outline:2px solid #f4d98a;outline-offset:2px}
  }
  @media (prefers-reduced-motion: reduce){ .mx-hero-video{display:none} }
</style>
