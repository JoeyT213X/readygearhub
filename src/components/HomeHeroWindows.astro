---
/**
 * Desktop-only product previews in the empty space to the right of the
 * Shop the Directory heading (same row, above the tile grid). Four small
 * windows fill that row and independently rotate through real catalog
 * products with official self-hosted photos. Hidden below 1024px.
 * No portable power stations, no robot-dog fillers, no badges or invented
 * stats. ShopBoard copy is not edited (us-first-badge adds .shop-board-topline
 * there).
 */
import { productPhotoFor } from '../data/product-photos';
import { headingProductHref, shortProductName, type CatalogItem } from '../data/full-catalog';

interface Props { products: CatalogItem[] }
const { products } = Astro.props;

const lanes: CatalogItem[][] = [[], [], [], []];
for (const [index, item] of products.entries()) {
  lanes[index % 4].push(item);
}
---
<aside class="home-hero-windows" aria-label="Featured products from the directory">
  <div class="home-hero-windows-stage">
    {lanes.map((lane, laneIndex) => (
      <div class="home-hero-slot" data-lane={laneIndex}>
        {lane.map((item, index) => {
          const photo = productPhotoFor(item);
          if (!photo) return null;
          const href = headingProductHref(item);
          return (
            <a
              class:list={['home-hero-window', { 'is-active': index === 0 }]}
              href={href}
              title={item.title}
            >
              <span class="home-hero-window-cover">
                <img
                  src={photo.src}
                  srcset={photo.srcset}
                  sizes="(min-width: 1024px) 160px, 0px"
                  alt={photo.alt}
                  width="160"
                  height="160"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="home-hero-window-title">{shortProductName(item.title)}</span>
            </a>
          );
        })}
      </div>
    ))}
  </div>
</aside>
<script>
  const desktop = window.matchMedia('(min-width: 1024px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const INTERVAL = 4500;
  const STAGGER = 1100;

  document.querySelectorAll('.home-hero-slot').forEach((slot, lane) => {
    const slides = Array.from(slot.querySelectorAll('.home-hero-window'));
    if (!slides.length) return;
    let index = 0;
    let timer = 0;
    let delay = 0;
    const show = (n: number) => {
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === n));
    };
    const stop = () => {
      if (delay) {
        window.clearTimeout(delay);
        delay = 0;
      }
      if (timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    };
    const start = () => {
      stop();
      if (!desktop.matches || reduce.matches || slides.length < 2) return;
      delay = window.setTimeout(() => {
        timer = window.setInterval(() => {
          index = (index + 1) % slides.length;
          show(index);
        }, INTERVAL);
      }, lane * STAGGER);
    };
    slot.addEventListener('mouseenter', stop);
    slot.addEventListener('mouseleave', start);
    slot.addEventListener('focusin', stop);
    slot.addEventListener('focusout', (event) => {
      if (!slot.contains((event as FocusEvent).relatedTarget as Node | null)) start();
    });
    desktop.addEventListener('change', () => {
      index = 0;
      show(0);
      start();
    });
    reduce.addEventListener('change', () => {
      index = 0;
      show(0);
      start();
    });
    show(0);
    start();
  });
</script>
