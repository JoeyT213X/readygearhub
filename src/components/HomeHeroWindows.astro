---
/**
 * Desktop-only compact preview in the empty space to the right of the
 * Shop the Directory heading (same row as the heading, above the tile
 * grid). Hidden below 1024px so mobile home stays unchanged. One window
 * crossfades through four internal directory previews. No portable power
 * stations, no badges or invented stats. ShopBoard copy is not edited
 * (us-first-badge adds .shop-board-topline there).
 */
import Photo from './Photo.astro';

type HeroWindow = { href: string; title: string; blurb: string; photo: string };

const previews: HeroWindow[] = [
  { href: '/prepper-picks/', title: 'Weather radios', blurb: 'NOAA and hand-crank radios.', photo: 'hero-radios' },
  { href: '/directory/water/', title: 'Water filtration', blurb: 'Filters from official shops.', photo: 'water-bottles' },
  { href: '/directory/safety/', title: 'First aid', blurb: 'Ready first-aid kits.', photo: 'first-aid-kit-open' },
  { href: '/directory/drones-robotics/', title: 'Drones & Robotics', blurb: 'Cameras and robot dogs.', photo: 'hero-drone' },
];
---
<aside class="home-hero-windows" aria-label="Featured from the directory">
  <div class="home-hero-windows-stage">
    {previews.map((tile, index) => (
      <a class:list={['home-hero-window', { 'is-active': index === 0 }]} href={tile.href}>
        <span class="home-hero-window-cover">
          <Photo name={tile.photo} sizes="(min-width: 1024px) 160px, 0px" alt={tile.title} />
        </span>
        <span class="home-hero-window-body">
          <span class="home-hero-window-title">{tile.title}</span>
          <span class="home-hero-window-blurb">{tile.blurb}</span>
        </span>
      </a>
    ))}
  </div>
</aside>
<script>
  const root = document.querySelector('.home-hero-windows');
  if (root) {
    const slides = Array.from(root.querySelectorAll('.home-hero-window'));
    const desktop = window.matchMedia('(min-width: 1024px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let timer = 0;
    const show = (n: number) => {
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === n));
    };
    const stop = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    };
    const start = () => {
      stop();
      if (!desktop.matches || reduce.matches || slides.length < 2) return;
      timer = window.setInterval(() => {
        index = (index + 1) % slides.length;
        show(index);
      }, 4500);
    };
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', (event) => {
      if (!root.contains((event as FocusEvent).relatedTarget as Node | null)) start();
    });
    desktop.addEventListener('change', () => {
      index = 0;
      show(0);
      start();
    });
    reduce.addEventListener('change', start);
    show(0);
    start();
  }
</script>
