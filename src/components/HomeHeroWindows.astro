---
/**
 * Product previews beside the Shop the Directory heading on desktop
 * (four small windows in that row, each rotating independently).
 * Hidden at 1023px and under: phones and tablets show the category tile
 * grid instead, with no swipe, dots, or rotation. No portable energy
 * reserves, no robot-dog fillers, no badges or invented stats.
 */
import { productPhotoFor } from '../data/product-photos';
import { headingProductHref, shortProductName, type CatalogItem } from '../data/full-catalog';

interface Props { products: CatalogItem[] }
const { products } = Astro.props;

const lanes: CatalogItem[][] = [[], [], [], []];
for (const [index, item] of products.entries()) {
  lanes[index % 4].push(item);
}
const filledLanes = lanes.filter((lane) => lane.some((item) => productPhotoFor(item)));
const laneCount = filledLanes.length;
---
<aside class="home-hero-windows" aria-label="Featured products from the directory" data-hero-windows>
  <div class="home-hero-windows-stage" data-hero-stage>
    {filledLanes.map((lane, laneIndex) => (
      <div class:list={['home-hero-slot', { 'is-active': laneIndex === 0 }]} data-lane={laneIndex}>
        {lane.map((item, index) => {
          const photo = productPhotoFor(item);
          if (!photo) return null;
          const href = headingProductHref(item);
          return (
            <a
              class:list={['home-hero-window', { 'is-active': index === 0 }]}
              href={href}
              title={item.title}
            >
              <span class="home-hero-window-cover">
                <img
                  src={photo.src}
                  srcset={photo.srcset}
                  sizes="(min-width: 1024px) 160px, (max-width: 768px) 25vw, 80vw"
                  alt={photo.alt}
                  width="160"
                  height="160"
                  loading={laneIndex === 0 && index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </span>
              <span class="home-hero-window-title">{shortProductName(item.title)}</span>
            </a>
          );
        })}
      </div>
    ))}
  </div>
  {laneCount > 1 && (
    <div class="home-hero-dots" role="tablist" aria-label="Featured product panels">
      {Array.from({ length: laneCount }, (_, i) => (
        <button
          type="button"
          class:list={['home-hero-dot', { 'is-active': i === 0 }]}
          data-hero-dot={i}
          aria-label={`Show featured product ${i + 1} of ${laneCount}`}
          aria-selected={i === 0 ? 'true' : 'false'}
        />
      ))}
    </div>
  )}
</aside>
<script>
  const root = document.querySelector<HTMLElement>('[data-hero-windows]');
  if (root) {
    const desktop = window.matchMedia('(min-width: 1024px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const phone = window.matchMedia('(max-width: 1023px)'); // phones and tablets: windows are hidden, nothing rotates or swipes
    const stage = root.querySelector<HTMLElement>('[data-hero-stage]')!;
    const slots = Array.from(root.querySelectorAll<HTMLElement>('.home-hero-slot'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const DESKTOP_INTERVAL = 4500;
    const MOBILE_INTERVAL = 4000;
    const STAGGER = 1100;

    const slotTimers: { timer: number; delay: number; index: number }[] = slots.map(() => ({
      timer: 0,
      delay: 0,
      index: 0,
    }));
    let mobileIndex = 0;
    let mobileTimer = 0;
    let holding = false;

    const showWindow = (slot: HTMLElement, n: number) => {
      slot.querySelectorAll('.home-hero-window').forEach((slide, i) => {
        slide.classList.toggle('is-active', i === n);
      });
    };
    const showSlot = (n: number) => {
      const count = slots.length;
      if (!count) return;
      mobileIndex = ((n % count) + count) % count;
      slots.forEach((slot, i) => slot.classList.toggle('is-active', i === mobileIndex));
      dots.forEach((dot, i) => {
        const on = i === mobileIndex;
        dot.classList.toggle('is-active', on);
        dot.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    };

    const stopDesktop = () => {
      for (const state of slotTimers) {
        if (state.delay) {
          window.clearTimeout(state.delay);
          state.delay = 0;
        }
        if (state.timer) {
          window.clearInterval(state.timer);
          state.timer = 0;
        }
      }
    };
    const stopMobile = () => {
      if (mobileTimer) {
        window.clearInterval(mobileTimer);
        mobileTimer = 0;
      }
    };
    const startDesktop = () => {
      stopDesktop();
      if (!desktop.matches || reduce.matches) return;
      slots.forEach((slot, lane) => {
        const slides = slot.querySelectorAll('.home-hero-window');
        if (slides.length < 2) return;
        const state = slotTimers[lane];
        state.delay = window.setTimeout(() => {
          state.timer = window.setInterval(() => {
            state.index = (state.index + 1) % slides.length;
            showWindow(slot, state.index);
          }, DESKTOP_INTERVAL);
        }, lane * STAGGER);
      });
    };
    const startMobile = () => {
      stopMobile();
      if (desktop.matches || phone.matches || reduce.matches || slots.length < 2 || holding) return;
      mobileTimer = window.setInterval(() => showSlot(mobileIndex + 1), MOBILE_INTERVAL);
    };
    const resetDesktopWindows = () => {
      slots.forEach((slot, lane) => {
        slotTimers[lane].index = 0;
        showWindow(slot, 0);
      });
    };
    const sync = () => {
      stopDesktop();
      stopMobile();
      if (desktop.matches) {
        showSlot(0);
        resetDesktopWindows();
        startDesktop();
      } else {
        resetDesktopWindows();
        showSlot(mobileIndex);
        startMobile();
      }
    };

    slots.forEach((slot, lane) => {
      slot.addEventListener('mouseenter', () => {
        if (!desktop.matches) return;
        const state = slotTimers[lane];
        if (state.delay) {
          window.clearTimeout(state.delay);
          state.delay = 0;
        }
        if (state.timer) {
          window.clearInterval(state.timer);
          state.timer = 0;
        }
      });
      slot.addEventListener('mouseleave', () => {
        if (desktop.matches) startDesktop();
      });
      slot.addEventListener('focusin', () => {
        if (!desktop.matches) return;
        const state = slotTimers[lane];
        if (state.delay) {
          window.clearTimeout(state.delay);
          state.delay = 0;
        }
        if (state.timer) {
          window.clearInterval(state.timer);
          state.timer = 0;
        }
      });
      slot.addEventListener('focusout', (event) => {
        if (!desktop.matches) return;
        if (!slot.contains((event as FocusEvent).relatedTarget as Node | null)) startDesktop();
      });
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        if (desktop.matches) return;
        showSlot(i);
        startMobile();
      });
    });

    let startX = 0;
    let startY = 0;
    let tracking = false;
    let swiped = false;
    const onDown = (event: PointerEvent) => {
      if (desktop.matches || phone.matches || (event.pointerType === 'mouse' && event.button !== 0)) return;
      tracking = true;
      swiped = false;
      startX = event.clientX;
      startY = event.clientY;
      holding = true;
      stopMobile();
    };
    const onUp = (event: PointerEvent) => {
      if (!tracking) return;
      tracking = false;
      holding = false;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
        swiped = true;
        showSlot(mobileIndex + (dx < 0 ? 1 : -1));
      }
      startMobile();
    };
    stage.addEventListener('pointerdown', onDown);
    window.addEventListener('pointerup', onUp);
    window.addEventListener('pointercancel', onUp);
    stage.addEventListener('click', (event) => {
      if (swiped) {
        event.preventDefault();
        event.stopPropagation();
        swiped = false;
      }
    }, true);

    phone.addEventListener('change', () => { holding = false; sync(); });
    desktop.addEventListener('change', () => {
      mobileIndex = 0;
      holding = false;
      sync();
    });
    reduce.addEventListener('change', () => {
      mobileIndex = 0;
      holding = false;
      sync();
    });
    root.classList.add('is-ready');
    sync();
  }
</script>
