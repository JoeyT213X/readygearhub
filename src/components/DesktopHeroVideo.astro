---
/**
 * Desktop only (1024px and up): a near-full-viewport muted looping background video is the home hero
 * (about 100svh minus the site header), with the U.S. Companies badge at the top and the same tagline
 * plus four buttons at the bottom. The existing Shop the Directory board, product windows and tiles
 * stay intact below. Hidden on smaller screens; the video file is not requested there (the poster is a
 * CSS background inside the desktop media query). Skipped for prefers-reduced-motion, Save-Data and
 * 2G/slow connections, with the poster as the still. Paused when scrolled out of view or the tab is
 * hidden. 17.3 s, about 4.4 MB, 1280x720, no audio, our own generated imagery (no logos or readable text).
 */
import UsFirstBadge from './UsFirstBadge.astro';
---
<section class="dx-hero" aria-label="Start here">
  <div class="dx-hero-bg" data-dx-hero aria-hidden="true">
    <video class="dx-hero-video" muted loop playsinline autoplay preload="none" tabindex="-1" disablepictureinpicture data-src="/videos/desktop-extreme-hero.mp4"></video>
    <span class="dx-hero-shade"></span>
  </div>
  <div class="dx-hero-inner">
    <div class="dx-hero-topline">
      <UsFirstBadge />
    </div>
    <p class="dx-hero-tag">Storms. Outages. Off-grid.<br />Be ready.</p>
    <nav class="dx-hero-cta" aria-label="Start here">
      <a class="dx-cta is-primary" href="/directory/">Shop gear</a>
      <a class="dx-cta" href="/doomsday-prepper/">Doomsday prep</a>
      <a class="dx-cta" href="/winter-deals/">Winter deals</a>
      <a class="dx-cta" href="/guides/">Read the guides</a>
    </nav>
  </div>
</section>
<script is:inline>
  (function () {
    var box = document.querySelector('[data-dx-hero]');
    if (!box || !window.matchMedia) return;
    if (!window.matchMedia('(min-width: 1024px)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var c = navigator.connection || {};
    if (c.saveData === true || /(^|-)2g$/.test(c.effectiveType || '')) return;
    var v = box.querySelector('video');
    var started = false;
    var start = function () {
      if (started) return;
      started = true;
      v.addEventListener('playing', function () { box.classList.add('is-playing'); }, { once: true });
      v.src = v.getAttribute('data-src');
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { v.play().catch(function () {}); } else { v.pause(); } });
        }, { threshold: 0.05 }).observe(box);
      }
      document.addEventListener('visibilitychange', function () { if (document.hidden) v.pause(); else v.play().catch(function () {}); });
    };
    var later = function () { if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2500 }); else setTimeout(start, 800); };
    if (document.readyState === 'complete') later(); else window.addEventListener('load', later, { once: true });
  })();
</script>
<style is:global>
  .dx-hero{display:none}
  @media (min-width: 1024px) {
    .dx-hero{
      display:block;
      position:relative;
      isolation:isolate;
      /* Viewport minus the sticky header (brand row ~62px + quick-links rail ~41px). */
      height:calc(100svh - 103px);
      min-height:520px;
      overflow:hidden;
      background:#0e1626;
    }
    .dx-hero-bg{
      position:absolute;
      inset:0;
      z-index:0;
      background:#0e1626 url('/videos/desktop-extreme-poster.jpg') center center/cover no-repeat;
    }
    .dx-hero-video{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center center;
      opacity:0;
      transition:opacity .5s ease;
    }
    .dx-hero-bg.is-playing .dx-hero-video{opacity:1}
    .dx-hero-shade{
      position:absolute;
      inset:0;
      background:linear-gradient(180deg,rgba(8,14,26,.58) 0%,rgba(8,14,26,.16) 28%,rgba(8,14,26,.18) 52%,rgba(8,14,26,.78) 78%,rgba(8,14,26,.92) 100%);
    }
    .dx-hero-inner{
      position:relative;
      z-index:1;
      display:flex;
      flex-direction:column;
      align-items:flex-start;
      justify-content:flex-start;
      height:100%;
      max-width:1320px;
      margin:0 auto;
      padding:22px 28px 32px;
      box-sizing:border-box;
    }
    .dx-hero-topline{flex:0 0 auto}
    .dx-hero-tag{
      display:block;
      margin:auto 0 18px;
      text-wrap:balance;
      font:800 clamp(2rem,4.2vw,3.15rem)/1.08 var(--font-display,Georgia,serif);
      letter-spacing:.005em;
      color:#fff;
      text-shadow:0 2px 18px rgba(0,0,0,.95),0 0 3px rgba(0,0,0,.9);
    }
    .dx-hero-cta{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      width:100%;
      max-width:920px;
    }
    .dx-cta{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:52px;
      padding:10px 22px;
      border-radius:8px;
      border:1px solid rgba(224,182,79,.75);
      background:rgba(10,20,34,.72);
      color:#fff;
      font:700 1.05rem/1.1 var(--font-sans,system-ui);
      text-align:center;
      text-decoration:none;
      text-shadow:0 1px 3px rgba(0,0,0,.8);
      -webkit-backdrop-filter:blur(3px);
      backdrop-filter:blur(3px);
    }
    .dx-cta.is-primary{background:#b22234;border-color:#e0b64f}
    .dx-cta:hover{background:rgba(18,32,50,.88);color:#fff}
    .dx-cta.is-primary:hover{background:#c92b40}
    .dx-cta:focus-visible{outline:2px solid #f4d98a;outline-offset:2px}
  }
  @media (prefers-reduced-motion: reduce){ .dx-hero-video{display:none} }
</style>
