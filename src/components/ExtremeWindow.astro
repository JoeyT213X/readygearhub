---
interface Props { embedded?: boolean; variant?: 'banner' | 'hero'; href?: string }
const { embedded = false, variant = 'banner', href = '/doomsday-prepper/' } = Astro.props;
/**
 * Home page "Extreme" window: Doomsday Prepper. 5-second muted looping background video (no people, our own licensed photos),
 * dark overlay for contrast, one link to /doomsday-prepper/. prefers-reduced-motion shows the poster only.
 */
---
<section class:list={["extreme-wrap", { "is-embedded": embedded }]} aria-label="Extreme: Doomsday Prepper">
  <div class:list={{ wrap: !embedded }}>
    <a class:list={["extreme-window", { "is-hero": variant === "hero" }]} href={href} data-extreme aria-label="Extreme: Doomsday Prepper">
      <video class="extreme-video" muted loop autoplay playsinline preload="auto" poster="/videos/doomsday-extreme-poster.jpg" aria-hidden="true" tabindex="-1" disablepictureinpicture>
        <source src="/videos/doomsday-extreme.webm" type="video/webm" />
        <source src="/videos/doomsday-extreme.mp4" type="video/mp4" />
      </video>
      <span class="extreme-shade" aria-hidden="true"></span>
      <span class="extreme-body">
        <span class="extreme-kicker">Extreme</span>
        <span class="extreme-title">Doomsday Prepper</span>
        <span class="extreme-line">Bunkers and shelters, armored and overland rigs, perimeter security, NBC air, long-term food and supplies for the long haul. U.S. makers first.</span>
        <span class="extreme-cta">Enter the section <span aria-hidden="true">→</span></span>
      </span>
    </a>
  </div>
</section>
<script is:inline>
  (function () {
    var w = document.querySelector('[data-extreme]');
    if (!w || !window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var v = w.querySelector('video');
    if (v) { v.pause(); v.removeAttribute('autoplay'); v.removeAttribute('preload'); while (v.firstChild) v.removeChild(v.firstChild); v.load(); }
    w.classList.add('is-still');
  })();
</script>
<style is:global>
  .extreme-wrap{padding:18px 0 8px}
  .extreme-wrap.is-embedded{padding:0}
  .shop-board .extreme-window{margin:4px 0 2px}
  .extreme-window{position:relative;display:block;overflow:hidden;border-radius:8px;border:2px solid #b08d3c;min-height:320px;background:#0e1626 url('/videos/doomsday-extreme-poster.jpg') center/cover no-repeat;color:#f7f1dc;text-decoration:none;box-shadow:0 10px 28px rgba(8,14,26,.35)}
  .extreme-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .extreme-window.is-still .extreme-video{display:none}
  .extreme-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,14,26,.78) 0%,rgba(8,14,26,.52) 42%,rgba(8,14,26,.18) 100%);pointer-events:none}
  .extreme-body{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:44px 40px;max-width:760px;min-height:320px;justify-content:center}
  .extreme-kicker{font:800 .95rem/1 var(--font-sans,system-ui);letter-spacing:.34em;text-transform:uppercase;color:#d9b24f;border-top:3px solid #b22234;padding-top:8px}
  .extreme-title{font:800 clamp(2.2rem,6vw,4rem)/1.02 var(--font-display,Georgia,serif);text-transform:uppercase;letter-spacing:.02em;color:#fff;text-shadow:0 2px 18px rgba(0,0,0,.9),0 0 3px rgba(0,0,0,.95)}
  .extreme-line{font-size:1.05rem;line-height:1.45;color:#eee6cf;max-width:56ch;text-shadow:0 2px 12px rgba(0,0,0,.95),0 0 3px rgba(0,0,0,.9)}
  .extreme-cta{margin-top:8px;display:inline-block;padding:11px 20px;background:#b22234;color:#fff;font-weight:700;border-radius:4px;border:1px solid #e0b64f}
  .extreme-window:hover .extreme-cta,.extreme-window:focus-visible .extreme-cta{background:#c92b40}
  .extreme-window:focus-visible{outline:3px solid #f4d98a;outline-offset:3px}
  .extreme-window.is-hero,.extreme-window.is-hero .extreme-body{min-height:420px}
  .extreme-window.is-hero .extreme-body{padding:56px 44px;max-width:820px}
  @media (max-width:640px){
    .extreme-window,.extreme-body{min-height:260px}
    .extreme-body{padding:28px 18px}
    .extreme-shade{background:linear-gradient(180deg,rgba(8,14,26,.40) 0%,rgba(8,14,26,.58) 100%)}
    .extreme-window.is-hero,.extreme-window.is-hero .extreme-body{min-height:320px}
  }
</style>
