<fieldset class="filter-toggles" style="border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:6px;justify-content:end">
  <legend>Filter (leave all off to show all)</legend>
  <div style="display:flex;flex-wrap:wrap;gap:8px">
    <label class="filter-toggle"><input type="checkbox" id="filter-winter" /> Winter</label>
    <label class="filter-toggle"><input type="checkbox" id="filter-severe" /> Severe</label>
    <label class="filter-toggle"><input type="checkbox" id="filter-hurricane" /> Hurricane/Tropical</label>
    <label class="filter-toggle"><input type="checkbox" id="filter-tornado" /> Tornado</label>
    <label class="filter-toggle"><input type="checkbox" id="filter-flood" /> Flood</label>
  </div>
</fieldset>
