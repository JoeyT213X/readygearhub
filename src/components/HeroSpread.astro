---
import Photo from './Photo.astro';
import type { HeroBentoTile } from '../data/full-catalog';

interface Props {
  title: string;
  lead: string;
  tiles: HeroBentoTile[];
}
const { title, lead, tiles } = Astro.props;
const byId = Object.fromEntries(tiles.map((t) => [t.id, t]));
const order: HeroBentoTile['id'][] = [
  'winter',
  'water',
  'food',
  'vehicle',
  'camping',
  'drones',
  'overland',
  'first-aid',
  'radios',
  'security',
  'prepper',
  'alerts',
];
---
<section class="hero is-bento">
  <div class="hero-bento">
    <div class="hero-bento-copy">
      <div class="hero-bento-actions">
        <a class="btn hero-btn-dir" href="/directory/">Ultimate Directory</a>
        <a class="btn ghost light hero-btn-hub" href="/alerts/">Outages, Alerts &amp; Checklists</a>
      </div>
      <div class="hero-bento-copy-text">
        <h1>{title}</h1>
        <p class="lead">{lead}</p>
      </div>
      <nav class="hero-quick hero-quick-left" aria-label="Quick links">
        <a class="hero-quick-link" href="/guides/">Guides<span class="hero-quick-arrow" aria-hidden="true">→</span></a>
        <a class="hero-quick-link" href="/tools/">Free tools<span class="hero-quick-arrow" aria-hidden="true">→</span></a>
        <a class="hero-quick-link" href="/winter-storm-ready-checklist/">Checklists<span class="hero-quick-arrow" aria-hidden="true">→</span></a>
      </nav>
      <nav class="hero-quick hero-quick-right" aria-label="More quick links">
        <a class="hero-quick-link" href="/storm-hurricane-prep/">Hurricane prep<span class="hero-quick-arrow" aria-hidden="true">→</span></a>
        <a class="hero-quick-link" href="/guides/">Guides<span class="hero-quick-arrow" aria-hidden="true">→</span></a>
        <a class="hero-quick-link" href="/local/">Local &amp; county<span class="hero-quick-arrow" aria-hidden="true">→</span></a>
      </nav>
    </div>
    {order.map((id) => {
      const tile = byId[id];
      if (!tile) return null;
      return (
        <a class:list={['hero-bento-tile', `is-${tile.id}`]} href={tile.href}>
          <Photo name={tile.photoKey} sizes="(max-width: 699px) 100vw, (max-width: 1099px) 50vw, 25vw" eager={tile.eager} decorative />
          <span class="hero-bento-chip">
            <span class="hero-bento-chip-label">{tile.label}</span>
            <span class="hero-bento-chip-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      );
    })}
  </div>
</section>
