---
interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;
---
<section class="hero is-bento is-copy-only">
  <div class="hero-bento">
    <div class="hero-bento-copy">
      <a class="btn hero-btn-dir" href="/directory/">Ultimate Directory</a>
      <div class="hero-bento-copy-text">
        <h1>{title}</h1>
        <p class="lead">{lead}</p>
      </div>
      <a class="btn ghost light hero-btn-hub" href="/alerts/">Outages, Alerts &amp; Checklists</a>
    </div>
  </div>
</section>
