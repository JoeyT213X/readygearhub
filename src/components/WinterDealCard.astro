---
import { outUrl, isAffiliate, programIdForItem, type Item } from '../lib/data';
import { isNoPpcProgram } from '../data/affiliates';
import { cardImageFor } from '../data/card-image';
import NameCover from './NameCover.astro';
import { retailLabel } from '../data/listing-actions';
import type { WinterDeal } from '../data/winter-deals';
import { honestPrice, honestSalePair } from '../lib/price';

interface Props {
  item: Item;
  deal: WinterDeal;
}
const { item, deal } = Astro.props;
if (!isAffiliate(item)) {
  throw new Error(`Winter deal ${item.id} is not a live affiliate listing and cannot appear on /winter-deals/.`);
}
const program = programIdForItem(item.id);
const photo = cardImageFor(item);
const href = outUrl(item);
// Wording comes from src/lib/price.ts and always carries this item's own checked date. The list/sale pair shows only
// where the data records that the brand's own page showed both; otherwise just the dated price, or where the price lives.
const sale = deal.priceLabel === 'See price' ? undefined : honestPrice(deal.priceLabel, deal.checked);
const pair = deal.compareAt && deal.compareSource ? honestSalePair(deal.compareAt, deal.priceLabel, deal.compareSource, deal.checked) : undefined;
const priceText = pair ?? sale ?? 'Price on the store page';
---
<article class="card item-card winter-deal-card" data-no-ppc={isNoPpcProgram(program) ? '' : undefined} data-program={isNoPpcProgram(program) ? program : undefined}>
  {photo && (
    <a class:list={['item-card-photo', photo.representative ? 'is-stock' : photo.backdrop]} href={`/gear/${item.id}/`} tabindex="-1" aria-hidden="true">
      <img src={photo.src} srcset={photo.srcset} sizes="(min-width: 900px) 360px, 92vw" alt="" width="960" height="540" loading="lazy" decoding="async" />
      {photo.representative && <span class="stock-chip">Representative photo</span>}
    </a>
  )}
  {!photo && <NameCover kicker={item.data.brand} title={item.data.name} href={`/gear/${item.id}/`} />}
  <p class="brand">{item.data.brand}</p>
  <h3><a href={`/gear/${item.id}/`}>{item.data.name}</a></h3>
  <p class="winter-deal-price">
    <span class="wd-now">{priceText}</span>
    {sale && <span class="wd-checked">Read on the official store.</span>}
  </p>
  {deal.stockNote && <p class="fine wd-stock">{deal.stockNote}</p>}
  <p>{deal.why}</p>
  <div class="card-actions">
    <a class="btn small ghost" href={`/gear/${item.id}/`}>Details</a>
    <a
      class="btn small"
      href={href}
      target="_blank"
      rel="sponsored nofollow noopener"
      data-program={program || undefined}
    >{retailLabel(item.id, !!sale)} ↗</a>
  </div>
</article>

<style>
  .winter-deal-price {
    margin: 0.35rem 0 0.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.55rem;
    align-items: baseline;
  }
  .wd-now {
    font-weight: 650;
    font-size: 1.05rem;
  }
  .wd-was {
    color: var(--muted, #5c6570);
    text-decoration: none;
  }
  .wd-checked,
  .wd-stock {
    flex-basis: 100%;
    margin: 0;
  }
</style>
