---
import Photo from './Photo.astro';
import UsFirstBadge from './UsFirstBadge.astro';
import { shopBoardCountLabel, type ShopBoardTile } from '../data/full-catalog';

interface Props {
  tiles: ShopBoardTile[];
  catalogCount: number;
  hero?: boolean;
}
const { tiles, catalogCount, hero = false } = Astro.props;
const countLabel = shopBoardCountLabel(catalogCount);

function isInternal(href: string) {
  return href.startsWith('/');
}
---
<div class:list={["bento-tile", "is-shop-board", "is-wide", { "is-hero": hero }]}>
  <div class="shop-board">
    <div class="shop-board-copy">
      <div class="shop-board-topline">
        <span class="bento-kicker">Explore</span>
        {hero && <UsFirstBadge />}
      </div>
      {hero ? <h1 class="shop-board-heading"><a class="shop-board-title" href="/directory/">Shop the Directory</a></h1> : <a class="shop-board-title" href="/directory/">Shop the Directory</a>}
      <p class="shop-board-text">{countLabel} listings from partner stores, official shops, gear write-ups, downloads, and free tools.</p>
    </div>
    <!-- Optional desktop heading-row preview; us-first-badge only edits shop-board-copy above. -->
    <slot name="aside" />
    <div class="shop-board-grid">
      {tiles.map((tile) => {
        const internal = isInternal(tile.href);
        return (
          <a
            class={`shop-board-cell is-${tile.fit}`}
            href={tile.href}
            data-no-ppc={tile.hideOnPaid ? '' : undefined}
            data-program={tile.hideOnPaid && tile.id.includes('waterdrop') ? 'waterdrop' : undefined}
            target={internal ? undefined : '_blank'}
            rel={internal ? undefined : (tile.rel || 'noopener')}
          >
            {tile.photoKey ? (
              <Photo name={tile.photoKey} sizes="(max-width: 719px) 30vw, 12vw" alt={tile.label} />
            ) : (
              <img src={tile.image} alt={tile.label} width="400" height="400" loading="lazy" decoding="async" />
            )}
            <span class="shop-board-caption">{tile.label}</span>
          </a>
        );
      })}
      <a class="shop-board-cell is-count" href="/directory/">
        <span class="shop-board-count-kicker">Directory</span>
        <span class="shop-board-count-num">{countLabel}</span>
        <span class="shop-board-caption">All listings</span>
      </a>
    </div>
  </div>
</div>
