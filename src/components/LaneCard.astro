---
import Photo from './Photo.astro';
import { photoForLane } from '../data/images';
interface Props { lane: { slug: string; name: string; icon: string; summary: string }; count: number; compact?: boolean }
const { lane, count, compact = false } = Astro.props;
---
<a class:list={['card', 'lane-card', { compact }]} href={`/${lane.slug}/`}>
  <span class="lane-card-img"><Photo name={photoForLane(lane.slug)} decorative sizes="(min-width: 980px) 25vw, (min-width: 640px) 50vw, 100vw" /></span>
  <span class="lane-card-body">
    <span class="lane-title"><span aria-hidden="true">{lane.icon}</span> {lane.name}</span>
    {!compact && <span class="lane-summary">{lane.summary}</span>}
    <span class="count">{count} picks →</span>
  </span>
</a>
