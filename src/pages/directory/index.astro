---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import SourceCard from '../../components/SourceCard.astro';
import DirectoryGroupTile from '../../components/DirectoryGroupTile.astro';
import ComingSoonPartners from '../../components/ComingSoonPartners.astro';
import { sourceGroups, sourceStores, comingSoonFor } from '../../data/source-directory';
import { getItems } from '../../lib/data';
import { buildFullCatalog, countsByCatalogGroup } from '../../data/full-catalog';

const items = buildFullCatalog(await getItems());
const stores = sourceStores();
const groupCounts = countsByCatalogGroup(items);
const pending = comingSoonFor();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Full Source Directory',
  description: 'A full catalog of partner stores, gear listings, downloads, free tools, and official resources on ReadyGearHub.',
  url: new URL('/directory/', Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: sourceGroups.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/directory/#${g.id}`, Astro.site).href,
      name: g.name,
    })),
  },
};
---
<Base
  title="Full Source Directory | ReadyGearHub"
  description="A full catalog of partner stores, preparedness gear listings, downloads, free tools, and official resources. Prices, stock, and terms live on the seller’s site."
  schema={schema}
>
  <PageHero
    title="Full Source Directory"
    eyebrow="Shop the full catalog"
    lead="Partner shops we already work with, gear listings with our write-ups, free tools, official resources, and space for stores still on the way. Prices, stock, and terms live on the seller’s site."
    photo="gear-flatlay"
    crumbs={[{ label: 'Full Source Directory' }]}
  />

  <section class="wrap section tight">
    <p class="disclosure"><strong>Affiliate disclosure:</strong> Many links on this page are affiliate links. If you buy or sign up through one, ReadyGearHub may earn a commission at no extra cost to you. We only use tracking links from programs we’re already approved for. We don’t invent prices or ratings; if we don’t already have a verified price, the card says “See price.” Paid plans and warranties are labeled as such. Some cards are official public resources or our own free tools, and those are marked that way. <a href="/affiliate-disclosure/">Full disclosure</a></p>
  </section>

  <section class="wrap section tight" id="categories">
    <SectionHead kicker="Browse" title="Shop by group" intro="Five broad groups. Each older category page is still available for a closer look." />
    <div class="grid five group-grid">
      {sourceGroups.map((g) => <DirectoryGroupTile group={g} count={groupCounts[g.id]} />)}
    </div>
  </section>

  <section class="wrap section" id="listings">
    <SectionHead kicker="Catalog" title="All listings" intro={`Filter by group or source. ${items.length} listings in all; trending items and product photos stay first.`} />
    <div class="dir-filters" data-source-filters data-page-size="60">
      <div class="filter-row">
        <p class="filter-label" id="filter-cat-label">Group</p>
        <div class="filter-pills" role="toolbar" aria-labelledby="filter-cat-label">
          <button type="button" class="pill" data-filter-cat="all" aria-pressed="true">All</button>
          <button type="button" class="pill" data-filter-cat="trending" aria-pressed="false">Trending</button>
          {sourceGroups.map((g) => (
            <button type="button" class="pill" data-filter-cat={g.id} aria-pressed="false">{g.short}</button>
          ))}
        </div>
      </div>
      <div class="filter-row">
        <p class="filter-label" id="filter-src-label">Source</p>
        <div class="filter-pills" role="toolbar" aria-labelledby="filter-src-label">
          <button type="button" class="pill" data-filter-src="all" aria-pressed="true">All sources</button>
          {stores.map((s) => (
            <button type="button" class="pill" data-filter-src={s.id} aria-pressed="false" data-program={s.programId !== 'payhip' ? s.programId : undefined} data-no-ppc={s.hideOnPaid ? '' : undefined}>{s.name}</button>
          ))}
          <button type="button" class="pill" data-filter-src="rgh-tools" aria-pressed="false">Free tools</button>
          <button type="button" class="pill" data-filter-src="official" aria-pressed="false">Official resources</button>
        </div>
      </div>
      <p class="fine" data-filter-status></p>
    </div>

    <div class="grid shop-grid source-grid" id="catalog-grid">
      {items.map((item) => <SourceCard item={item} />)}
    </div>
    <p class="dir-more"><button type="button" class="btn ghost" data-load-more hidden>Load more</button></p>

    <ComingSoonPartners partners={pending} heading="More partners coming soon" />
  </section>

  <section class="wrap section tight prose">
    <h2>How this directory works</h2>
    <p>Partner-store cards use the same approved tracking links already on ReadyGearHub. Gear listings open our write-up and a button to the official product page, using the same outbound link as the gear directory. Our downloads check out through Payhip. Free tools and apps live on this site. Official public resources (Ready.gov, NWS, FEMA, and similar) are plain links, not affiliate offers. Some partner cards are hidden if you arrived from a paid ad, because those partners don’t allow paid-search promotion.</p>
    <p>Looking for organic gear write-ups grouped by situation? See the <a href="/gear/">gear directory</a> and <a href="/shop/">printable guides shop</a>. Individual category pages such as <a href="/directory/power/">Power &amp; Energy</a> and <a href="/directory/tech/">Tech &amp; Gadgets</a> are still here.</p>
  </section>

  <script>
    import { initSourceDirectoryFilters } from '../../scripts/source-directory';
    initSourceDirectoryFilters();
    document.querySelectorAll('[data-jump-src]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = (a as HTMLElement).getAttribute('data-jump-src');
        const btn = document.querySelector<HTMLButtonElement>(`[data-filter-src="${id}"]`);
        if (btn) {
          e.preventDefault();
          btn.click();
          document.getElementById('listings')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</Base>
