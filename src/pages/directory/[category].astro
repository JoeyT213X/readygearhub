---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CategoryShort from '../../components/CategoryShort.astro';
import SectionHead from '../../components/SectionHead.astro';
import SourceCard from '../../components/SourceCard.astro';
import ComingSoonPartners from '../../components/ComingSoonPartners.astro';
import Disclosure from '../../components/Disclosure.astro';
import {
  sourceCategories,
  sourceStores,
  comingSoonFor,
  categoryBySlug,
} from '../../data/source-directory';
import WinterDealsCallout from '../../components/WinterDealsCallout.astro';
import { isWinterDealDirectoryCategory } from '../../data/winter-deals';
import { getItems } from '../../lib/data';
import { buildFullCatalog } from '../../data/full-catalog';
import { brandPages } from '../../data/brands';

export function getStaticPaths() {
  return sourceCategories.map((c) => ({ params: { category: c.slug } }));
}

const slug = Astro.params.category as string;
const category = categoryBySlug(slug);
if (!category) throw new Error(`Unknown directory category: ${slug}`);

const all = buildFullCatalog(await getItems());
const items = all.filter((i) => i.category === category.id || (i.alsoIn ?? []).includes(category.id));
const primaryItems = items.filter((i) => !i.filler);
const fillerItems = items.filter((i) => i.filler);
const pending = comingSoonFor(category.id);
const spotlightCats = new Set(['power', 'outdoor', 'auto']);
const spotlights = spotlightCats.has(category.id) ? brandPages.filter((b) => category.id !== 'auto' || b.slug === 'litime') : [];
const storesInCat = sourceStores().filter((s) => items.some((i) => i.programId === s.id));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} · Full Source Directory`,
  description: category.blurb,
  url: new URL(`/directory/${category.slug}/`, Astro.site).href,
  isPartOf: new URL('/directory/', Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.title,
      url: item.href.startsWith('/') ? new URL(item.href, Astro.site).href : item.href,
    })),
  },
};
---
<Base
  title={`${category.name} · Full Source Directory | ReadyGearHub`}
  description={category.blurb}
  schema={schema}
  pageClass={category.id === 'drones-robotics' ? 'dir-drones-robotics' : undefined}
>
  <PageHero
    title={category.name}
    eyebrow="Full Source Directory"
    lead={category.blurb}
    photo={category.photo}
    crumbs={[{ href: '/directory/', label: 'Full Source Directory' }, { label: category.name }]}
  >
    <CategoryShort path={`/directory/${category.slug}/`} />
  </PageHero>

  <section class="wrap section">
    {isWinterDealDirectoryCategory(category.id) && (
      <WinterDealsCallout />
    )}

    {spotlights.length > 0 && (
      <p class="fine brand-spotlight-strip"><strong>Brand spotlights:</strong> {spotlights.map((b, i) => (<>{i > 0 && ' · '}<a href={`/brands/${b.slug}/`}>{b.name}</a></>))} · <a href="/brands/">All spotlights</a></p>
    )}

    <div class="dir-filters" data-source-filters data-current-cat={category.id}>
      {storesInCat.length > 1 && (
        <div class="filter-row">
          <p class="filter-label" id="filter-src-label">Store</p>
          <div class="filter-pills" role="toolbar" aria-labelledby="filter-src-label">
            <button type="button" class="pill" data-filter-src="all" aria-pressed="true">All stores</button>
            {storesInCat.map((s) => (
              <button type="button" class="pill" data-filter-src={s.id} aria-pressed="false" data-program={s.programId !== 'payhip' ? s.programId : undefined} data-no-ppc={s.hideOnPaid ? '' : undefined}>{s.name}</button>
            ))}
          </div>
        </div>
      )}
      {items.length > 0 && (
        <p class="fine" data-filter-status>{items.length} {items.length === 1 ? 'listing' : 'listings'}</p>
      )}
    </div>

    <Disclosure />

    <section class="dir-section" data-dir-section={category.id}>
      {primaryItems.length > 0 ? (
        <div class="grid shop-grid source-grid">
          {primaryItems.map((item) => <SourceCard item={item} />)}
        </div>
      ) : items.length === 0 ? (
        <p>No listings in this category yet. Partners still on the way are listed below.</p>
      ) : null}
      {fillerItems.length > 0 && (
        <div class="filler-block">
          <h2 class="section-title">More robot dogs</h2>
          <p class="fine">Additional four-legged robots from other makers, listed for reference. Prices and stock are on each store’s page.</p>
          <div class="grid shop-grid source-grid is-filler-grid">
            {fillerItems.map((item) => <SourceCard item={item} />)}
          </div>
        </div>
      )}
      <ComingSoonPartners partners={pending} />
    </section>

    {category.id === 'drones-robotics' && (
      <details class="listing-notes">
        <summary>About these listings</summary>
        <p class="fine">These are listings from stores we have applied to, with plain links to each store’s own product page. Prices and stock change often, so confirm them on the store. The main robot listings here are Faraday Future (FF EAI Robotics, California) quadrupeds sold through Robots International. Drone listings are HOVERAir self-flying cameras. Additional robot-dog models from other makers are listed at the bottom of this page. Drone rules: since Dec 22, 2025, new foreign-made drone models can’t get FCC authorization for sale in the US. Models authorized before then can still be sold and flown, so what a store offers can change. Follow FAA and local rules wherever you fly.</p>
      </details>
    )}

    <p class="fine" style="margin-top:2rem"><a href="/directory/">← All Full Source Directory categories</a> · <a href="/gear/">Gear directory</a></p>
  </section>

  <nav class="wrap section tight" aria-label="Other categories">
    <SectionHead title="More categories" href="/directory/" linkLabel="Full directory" />
    <ul class="dir-nav">
      {sourceCategories.filter((c) => c.id !== category.id).map((c) => (
        <li><a class="pill" href={`/directory/${c.slug}/`}>{c.name}</a></li>
      ))}
    </ul>
  </nav>

  {storesInCat.length > 1 && (
    <script>
      import { initSourceDirectoryFilters } from '../../scripts/source-directory';
      initSourceDirectoryFilters();
    </script>
  )}
</Base>
