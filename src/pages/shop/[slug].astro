---
import Base from '../../layouts/Base.astro';
import PayhipBuyButton from '../../components/PayhipBuyButton.astro';
import MailerLiteSignup from '../../components/MailerLiteSignup.astro';
import { payhipProducts, type PayhipProduct } from '../../data/payhip';
import { shopProductSchema } from '../../lib/shop-schema';

export function getStaticPaths() {
  return payhipProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: PayhipProduct }
const { product } = Astro.props;
const url = new URL(`/shop/${product.slug}/`, Astro.site).href;
const image = new URL(product.image, Astro.site).href;
const schema = shopProductSchema(product, url, image);
---
<Base title={`${product.title} | ReadyGearHub`} description={product.description} image={product.image} schema={schema} type="product">
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/shop/">Shop</a></nav>
      <h1>{product.title}</h1>
      <p class="lead">{product.description}</p>
      <p class="product-price hero-price">{product.price}</p>
      <div class="hero-actions">
        <PayhipBuyButton product={product} />
        <a class="btn ghost light" href="/shop/">All guides</a>
      </div>
      <p class="fine light">Digital downloads are a final sale, except if a file is broken or does not work as described. <a href="/refund-policy/">Refund policy</a>.</p>
    </div>
  </section>
  <section class="wrap section product-detail">
    <img class="product-hero-img" src={product.image} alt="" width="960" height="540" />
    <div class="prose">
      <h2>What's included</h2>
      <ul>
        {product.includes.map((item) => <li>{item}</li>)}
      </ul>
      <p class="fine">Instant PDF download after checkout, through Payhip. There is no physical shipment. Personal-use license. This is a planning tool, not professional, legal, or medical advice. Always follow official guidance and manufacturer safety instructions. Questions about an order: <a href="/contact/">contact us</a>. Digital downloads are a final sale, except if a file is broken or does not work as described. See the <a href="/refund-policy/">refund policy</a>.</p>
      <div class="card-actions" style="padding-top:16px">
        <PayhipBuyButton product={product} />
      </div>
      {product.preview && product.preview.length > 0 && (
        <>
          <h2>A look inside: all {product.preview.length} pages</h2>
          <ol class="binder-pages">
            {product.preview.map((pg) => <li><strong>{pg.title}</strong> — {pg.note}</li>)}
          </ol>
        </>
      )}
      <h2>Questions people ask</h2>
      <div class="faq-list">
        {product.faq?.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        <details>
          <summary>Can I get a refund?</summary>
          <p>Digital downloads are a final sale. If a file is broken, will not open or download, or does not work as described, we give a full refund, or a replacement if you prefer. See the <a href="/refund-policy/">refund policy</a>.</p>
        </details>
      </div>
      {product.freeSignup && (
        <MailerLiteSignup
          variant="card"
          heading="Not ready to buy? Start with our free printable household guide"
          intro="Leave your email and we'll hand you the free Winter Storm Ready Checklist right away, including a contacts page you can fill in today. Now and then we'll send a calm seasonal reminder to check your kit and update your numbers."
        />
      )}
      {product.related.length > 0 && (
        <>
          <h2>Related on ReadyGearHub</h2>
          <ul>
            {product.related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}
          </ul>
        </>
      )}
    </div>
  </section>
</Base>
