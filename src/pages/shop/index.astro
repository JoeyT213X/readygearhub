---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { payhipProducts, PAYHIP_GUIDE_PRICE, PAYHIP_BUNDLE_PRICE } from '../../data/payhip';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ReadyGearHub shop',
  description: 'Printable ReadyGearHub preparedness guides and planners, sold as instant PDF downloads.',
  url: new URL('/shop/', Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: payhipProducts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/shop/${p.slug}/`, Astro.site).href,
      name: p.title,
    })),
  },
};
---
<Base title="Shop: Printable Prep Guides & Planners | ReadyGearHub" description={`Print-at-home ReadyGearHub guides: the Family Emergency Binder, Winter Storm Prep Planner, and Homestead Prep Starter Guide, ${PAYHIP_GUIDE_PRICE} each, or ${PAYHIP_BUNDLE_PRICE} for all three together. Instant PDF downloads.`} schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › Shop</nav>
      <h1>Shop</h1>
      <p class="lead">Print-at-home ReadyGearHub guides, {PAYHIP_GUIDE_PRICE} each, or {PAYHIP_BUNDLE_PRICE} for all three together. Checkout is handled by Payhip, and you get an instant PDF download. These are our own digital products, not affiliate gear listings. Digital downloads are a final sale, except if a file is broken or does not work as described. See the <a href="/refund-policy/">refund policy</a>.</p>
    </div>
  </section>
  <section class="wrap section">
    <div class="grid">{payhipProducts.map((p) => <ProductCard product={p} />)}</div>
  </section>
  <section class="wrap section prose">
    <h2>Questions people ask</h2>
    <div class="faq-list">
      <details>
        <summary>Can I get a refund?</summary>
        <p>Digital downloads are a final sale. If a file is broken, will not open or download, or does not work as described, we give a full refund, or a replacement if you prefer. See the <a href="/refund-policy/">refund policy</a>.</p>
      </details>
    </div>
  </section>
</Base>
