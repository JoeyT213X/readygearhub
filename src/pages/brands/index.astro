---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Disclosure from '../../components/Disclosure.astro';
import Photo from '../../components/Photo.astro';
import { brandPages } from '../../data/brands';

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Brand spotlights', url: new URL('/brands/', Astro.site).href,
    description: 'Closer looks at partner brands we link: who they suit, our picks, how to choose, and common questions.' },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Brand spotlights', numberOfItems: brandPages.length,
    itemListElement: brandPages.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, url: new URL(`/brands/${b.slug}/`, Astro.site).href })) },
];
---
<Base title="Brand spotlights | ReadyGearHub" description="Closer looks at partner brands we link: who they suit, our picks, how to choose, and common questions." schema={schema}>
  <PageHero title="Brand spotlights" eyebrow="Partners we link" lead="Longer write-ups on partner brands: who each one suits, which products we would look at first, and how to choose." crumbs={[{ label: 'Brand spotlights' }]} />
  <section class="wrap section">
    <Disclosure />
    <div class="grid">
      {brandPages.map((b) => (
        <a class="card brand-tile" href={`/brands/${b.slug}/`}>
          <Photo name={b.photo} sizes="(min-width: 900px) 30vw, 92vw" alt={b.photoNote} />
          <h2>{b.name}</h2>
          <p>{b.summary}</p>
          <span class="btn small">Read the spotlight</span>
        </a>
      ))}
    </div>
  </section>
</Base>
