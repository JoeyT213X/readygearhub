---
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import MailerLiteSignup from '../components/MailerLiteSignup.astro';
import SectionHead from '../components/SectionHead.astro';
import Photo from '../components/Photo.astro';
import LiveStatus from '../components/LiveStatus.astro';
import SourceCard from '../components/SourceCard.astro';
import DirectoryGroupTile from '../components/DirectoryGroupTile.astro';
import { getGuides, site } from '../lib/data';
import { sourceGroups, trendingSourceItems, countsByGroup, resolvedSourceItems } from '../data/source-directory';
import { mailerlite } from '../data/mailerlite';

const guides = await getGuides();
const guideById = Object.fromEntries(guides.map((g) => [g.id, g]));
const featuredIds = ['winter-storm-power-outage-prep-guide-south', 'winter-power-outage-checklist', 'emergency-water-storage', 'generator-vs-power-station', 'how-to-stay-warm-without-power'];
const featured = [...featuredIds.map((id) => guideById[id]).filter(Boolean)];

const sourceCatalog = resolvedSourceItems();
const sourceTrending = trendingSourceItems(sourceCatalog).slice(0, 8);
const groupCounts = countsByGroup(sourceCatalog);

const collage = [
  { id: 'directory', href: '/directory/', title: 'Shop the Directory', text: 'Partner stores and our downloads, in one catalog.', photo: null as string | null, image: '/directory/photos/bluetti-elite-200-v2.webp', feature: true },
  { id: 'guides', href: '/guides/', title: 'Guides', text: 'Checklists and how-tos in plain English.', photo: 'checklist-writing', image: null as string | null, feature: false },
  { id: 'tools', href: '/tools/', title: 'Free tools & apps', text: 'Calculators and offline tools. No account needed.', photo: 'power-banks', image: null, feature: false },
  { id: 'downloads', href: '/shop/', title: 'Our Downloads', text: 'Print-at-home planners and binders.', photo: 'gear-flatlay', image: null, feature: false },
  { id: 'local', href: '/local/', title: 'Local & county info', text: 'Mississippi offices, shelters, and outage maps.', photo: 'lightning-road', image: null, feature: false },
];

const webSite = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url };
const navList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ReadyGearHub',
  itemListElement: [
    { '@type': 'ListItem', position: 1, url: new URL('/directory/', Astro.site).href, name: 'Full Source Directory' },
    { '@type': 'ListItem', position: 2, url: new URL('/guides/', Astro.site).href, name: 'Guides' },
    { '@type': 'ListItem', position: 3, url: new URL('/tools/', Astro.site).href, name: 'Free tools' },
    { '@type': 'ListItem', position: 4, url: new URL('/alerts/', Astro.site).href, name: 'Live official alerts' },
    { '@type': 'ListItem', position: 5, url: new URL('/shop/', Astro.site).href, name: 'Our Downloads' },
    { '@type': 'ListItem', position: 6, url: new URL('/local/', Astro.site).href, name: 'Local and county info' },
  ],
};
---
<Base title="ReadyGearHub: Winter Storm, Power Outage & Survival Gear Directory" description="A hand-picked directory of winter storm, power outage, vehicle emergency, off-grid, and multi-purpose gear from trusted brands, plus guides, free tools, and live official alerts." schema={[webSite, navList]}>
  <section class="hero is-compact">
    <div class="hero-media" aria-hidden="true"><Photo name="hero-snowy-home" sizes="(max-width: 699px) 640px, 100vw" eager decorative /></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1>{site.hero.title}</h1>
      <p class="lead">Shop partner stores, read the guides, and check live official alerts.</p>
      <div class="hero-actions">
        <a class="btn" href="/directory/">Shop the Directory</a>
        <a class="btn ghost light" href="/guides/winter-power-outage-checklist/">Winter outage checklist</a>
      </div>
    </div>
  </section>

  <div class="wrap home-collage">
    <nav class="bento" aria-label="What's on ReadyGearHub">
      {collage.map((tile) => (
        <a class:list={['bento-tile', tile.feature && 'is-feature']} href={tile.href}>
          {tile.image ? (
            <img src={tile.image} alt="" width="800" height="800" loading="eager" decoding="async" />
          ) : (
            <Photo name={tile.photo!} decorative sizes={tile.feature ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'} />
          )}
          <span class="bento-tile-body">
            <span class="bento-kicker">Explore</span>
            <span class="bento-title">{tile.title}</span>
            <span class="bento-text">{tile.text}</span>
          </span>
        </a>
      ))}
    </nav>
  </div>

  <LiveStatus compact />

  <section class="wrap section tight" id="directory">
    <SectionHead kicker="Shop" title="Shop the Full Source Directory" intro="Five broad groups from partner stores we already work with. Open the directory for the full catalog." href="/directory/" linkLabel="Open the directory" />
    <Disclosure />
    <div class="grid five group-grid">{sourceGroups.map((g) => <DirectoryGroupTile group={g} count={groupCounts[g.id]} />)}</div>
    {sourceTrending.length > 0 && (
      <div class="trend-block">
        <h3 class="trend-label">Trending now</h3>
        <div class="trend-row" tabindex="0" aria-label="Trending directory listings">
          {sourceTrending.map((item) => <SourceCard item={item} />)}
        </div>
        <p class="fine trend-more"><a href="/directory/#listings">See all listings in the directory</a></p>
      </div>
    )}
  </section>

  <section class="wrap section tight" id="guides">
    <SectionHead kicker="Guides" title="Start with a guide" href="/guides/" linkLabel="All guides" />
    <ul class="guide-compact">
      {featured.map((g) => (
        <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>
      ))}
    </ul>
  </section>

  {mailerlite.enabled && (
    <section class="wrap section tight" id="signup">
      <MailerLiteSignup variant="home" />
    </section>
  )}
</Base>
