---
import Base from '../layouts/Base.astro';
import Disclosure from '../components/Disclosure.astro';
import MailerLiteSignup from '../components/MailerLiteSignup.astro';
import SectionHead from '../components/SectionHead.astro';
import HeroSpread from '../components/HeroSpread.astro';
import ShopBoard from '../components/ShopBoard.astro';
import HomeHeroWindows from '../components/HomeHeroWindows.astro';
import LiveStatus from '../components/LiveStatus.astro';
import SourceCard from '../components/SourceCard.astro';
import GuideCard from '../components/GuideCard.astro';
import DirectoryGroupTile from '../components/DirectoryGroupTile.astro';
import { getGuides, getItems, site } from '../lib/data';
import { sourceGroups } from '../data/source-directory';
import { mailerlite } from '../data/mailerlite';
import { buildFullCatalog, homeShopPicks, homeHeadingProducts, countsByCatalogGroup, shopBoardTiles, heroBentoTiles } from '../data/full-catalog';

const guides = await getGuides();
const guideById = Object.fromEntries(guides.map((g) => [g.id, g]));
const featuredIds = ['winter-storm-power-outage-prep-guide-south', 'winter-power-outage-checklist', 'emergency-water-storage', 'storm-first-aid-kit', 'how-to-stay-warm-without-power'];
const featured = [...featuredIds.map((id) => guideById[id]).filter(Boolean)];

// Drones & Robotics lives on /directory/ only; keep it off the home page and out of its counts.
const catalog = buildFullCatalog(await getItems()).filter((i) => i.category !== 'drones-robotics');
const shopPicks = homeShopPicks(catalog, 16);
const headingProducts = homeHeadingProducts(catalog);
const boardTiles = shopBoardTiles(catalog);
const heroTiles = heroBentoTiles();
const groupCounts = countsByCatalogGroup(catalog);

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  name: site.name,
  url: site.url,
  description: 'A hand-picked directory of winter storm, power outage, vehicle emergency, off-grid, and multi-purpose gear from trusted brands, plus guides, free tools, and live official alerts.',
  inLanguage: 'en-US',
  publisher: { '@id': new URL('/#organization', Astro.site).href },
};
const navList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ReadyGearHub',
  itemListElement: [
    { '@type': 'ListItem', position: 1, url: new URL('/directory/', Astro.site).href, name: 'Full Source Directory' },
    { '@type': 'ListItem', position: 2, url: new URL('/guides/', Astro.site).href, name: 'Guides' },
    { '@type': 'ListItem', position: 3, url: new URL('/tools/', Astro.site).href, name: 'Free tools' },
    { '@type': 'ListItem', position: 4, url: new URL('/alerts/', Astro.site).href, name: 'Live official alerts' },
    { '@type': 'ListItem', position: 5, url: new URL('/winter-storm-ready-checklist/', Astro.site).href, name: 'Free checklists' },
    { '@type': 'ListItem', position: 6, url: new URL('/local/', Astro.site).href, name: 'Local and county info' },
    { '@type': 'ListItem', position: 7, url: new URL('/prepper-picks/', Astro.site).href, name: 'Prepper’s Picks' },
  ],
};
import ExtremeWindow from '../components/ExtremeWindow.astro';
import MobileHeroVideo from '../components/MobileHeroVideo.astro';
import DesktopHeroVideo from '../components/DesktopHeroVideo.astro';
---
<Base footerSignup={false} title="ReadyGearHub: Winter Storm, Power Outage & Survival Gear Directory" description="A hand-picked directory of winter storm, power outage, vehicle emergency, off-grid, and multi-purpose gear from trusted brands, plus guides, free tools, and live official alerts." schema={[webSite, navList]}>
  <DesktopHeroVideo />
  <section class="home-shop-hero" aria-label="Shop the Directory">
    <div class="wrap">
      <ShopBoard hero tiles={boardTiles} catalogCount={catalog.length}>
        <MobileHeroVideo slot="copy-bg" />
        <HomeHeroWindows slot="aside" products={headingProducts} />
        <ExtremeWindow slot="between" embedded />
      </ShopBoard>
    </div>
  </section>

  <HeroSpread
    title="Prepping & Survival Network"
    lead="From go-bags to drones. Every shop, one hub."
    tiles={heroTiles}
  />

  <section class="wrap section band-stone" id="guides">
    <SectionHead kicker="Guides" title="Start with a guide" href="/guides/" linkLabel="All guides" />
    <div class="grid home-guides">
      {featured.map((g, i) => <GuideCard guide={g} size={i === 0 ? 'large' : 'normal'} />)}
    </div>
  </section>

  {mailerlite.enabled && (
    <section class="wrap section band-storm home-signup" id="signup">
      <div class="home-signup-grid">
        <div class="home-signup-copy">
          <p class="kicker">Free email</p>
          <h2>Get storm-ready tips by email</h2>
          <p>Occasional checklists and seasonal reminders. Unsubscribe anytime.</p>
          <ul class="check-list">
            <li><a href="/updates/">Local and community safety updates</a></li>
            <li><a href="/winter-storm-ready-checklist/">Free winter storm checklist</a></li>
            <li><a href="/alerts/">Live official weather alerts</a></li>
          </ul>
        </div>
        <MailerLiteSignup variant="home" heading="" intro="" />
      </div>
    </section>
  )}

  <LiveStatus compact />

  <section class="wrap section band-storm" id="directory">
    <SectionHead kicker="Shop" title="Shop the Full Source Directory" intro={`The full catalog: partner stores, gear listings, and free tools. ${catalog.length} listings in all.`} href="/directory/" linkLabel="Open the directory" />
    <Disclosure />
    <div class="grid four group-grid">{sourceGroups.map((g) => <DirectoryGroupTile group={g} count={groupCounts[g.id]} />)}</div>
    <div class="grid shop-grid source-grid home-shop-grid" style="margin-top:28px">
      {shopPicks.map((item) => <SourceCard item={item} />)}
    </div>
    <p class="fine trend-more"><a href="/directory/#listings">See all {catalog.length} listings in the directory</a></p>
  </section>
</Base>
