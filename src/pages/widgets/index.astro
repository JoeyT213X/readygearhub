---
import RelatedLinks from '../../components/RelatedLinks.astro';
import Base from '../../layouts/Base.astro';
import AlertDisclaimer from '../../components/AlertDisclaimer.astro';
import '../../styles/interactive.css';
import states from '../../data/us-states.json';
import { DEFAULT_STATE } from '../../lib/app-config';
import { DEFAULT_REGION_SLUG, WIDGET_REGIONS, regionBySlug } from '../../data/widget-regions';

const site = Astro.site ? new URL(Astro.site).origin : 'https://readygearhub.com';
const requested = regionBySlug(Astro.url.searchParams.get('region'));
const initialRegion = requested?.slug || DEFAULT_REGION_SLUG;
---
<Base title="Embeddable Widgets | ReadyGearHub" description="Free, copy-paste winter storm alert box for Mississippi community sites. Official National Weather Service alerts for your region, with no ads or cookies.">
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Widgets</p>
      <h1>Embeddable widgets</h1>
      <p class="lead">Add a free winter storm alert box to your site. It shows official National Weather Service winter storm, ice, and freeze alerts for a Mississippi region, plus one safety tip. No ads, no product links, and no cookies.</p>
    </div>
  </section>
  <section class="wrap section">
    <AlertDisclaimer />
    <p>These widgets are informational and are not a substitute for Wireless Emergency Alerts, NOAA Weather Radio, the MEMA app, or local officials.</p>

    <h2>Winter storm alert box</h2>
    <p>Pick a region, preview the box, and copy the snippet. Use this page as the outreach landing link: <a href={`${site}/widgets/?region=${initialRegion}`}>{`${site}/widgets/?region=${initialRegion}`}</a></p>
    <form class="card form" id="region-builder" onsubmit="return false;">
      <div class="tool-toolbar" style="margin:0">
        <label>Mississippi region
          <select id="w-region">
            {WIDGET_REGIONS.map((r) => <option value={r.slug} selected={r.slug === initialRegion}>{r.name}</option>)}
          </select>
        </label>
      </div>
      <p class="fine">Preview uses this page’s address. The embed code always points at {site} so it works when you paste it on another site.</p>
      <iframe id="region-preview" class="embed-preview" title="Winter storm alert widget preview" loading="lazy" style="height:360px"></iframe>
      <p class="fine"><a href={`/widgets/alert/?region=${initialRegion}`}>Open the regional alert widget on its own page</a></p>
      <label>Copy-paste embed code
        <textarea id="region-code" class="embed-code" readonly rows="7"></textarea>
      </label>
      <div class="tool-actions">
        <button type="button" class="btn" id="copy-region">Copy embed code</button>
      </div>
    </form>

    <h2 style="margin-top:2em">Embed terms</h2>
    <ol>
      <li>Free to embed on any non-commercial or commercial site. No fee, no exclusivity.</li>
      <li>Keep the attribution line visible and unaltered, and keep the NWS credit.</li>
      <li>The ReadyGearHub credit uses plain brand anchor text and <code>rel="nofollow"</code>. If a placement is ever paid or exchanged for anything of value, that link must be marked <code>rel="sponsored"</code>. We do not pay for embeds and do not expect SEO credit from them.</li>
      <li>No hidden links, and no extra links stuffed into the widget.</li>
      <li>Hosts may remove the widget anytime. We may update its content or retire it, with notice on this page.</li>
      <li>The widget is informational and not an official warning system, and that disclaimer is displayed. No warranty of timeliness.</li>
      <li>Privacy: the widget sets no cookies and loads no third-party trackers or ads. The box talks only to the official National Weather Service API in the visitor’s browser.</li>
    </ol>

    <h2 style="margin-top:2em">County-level alerts badge</h2>
    <p>Need a single county, or a state other than Mississippi? This badge shows all current NWS alerts for a county you choose.</p>
    <form class="card form" id="alerts-builder" onsubmit="return false;">
      <div class="tool-toolbar cols-2" style="margin:0">
        <label>State
          <select id="w-state">
            {states.map((s) => <option value={s.code} selected={s.code === DEFAULT_STATE}>{s.name}</option>)}
          </select>
        </label>
        <label>County
          <select id="w-county"><option value="">All counties</option></select>
        </label>
      </div>
      <iframe id="alerts-preview" class="embed-preview" title="County alerts widget preview" loading="lazy"></iframe>
      <label>Copy-paste embed code
        <textarea id="alerts-code" class="embed-code" readonly rows="5"></textarea>
      </label>
      <div class="tool-actions">
        <button type="button" class="btn" id="copy-alerts">Copy embed code</button>
      </div>
    </form>

    <h2 style="margin-top:2em">Storm-prep countdown</h2>
    <form class="card form" id="count-builder" onsubmit="return false;">
      <div class="tool-toolbar cols-2" style="margin:0">
        <label>Label
          <input type="text" id="c-label" value="Storm prep" maxlength="80" />
        </label>
        <label>Target date
          <input type="date" id="c-date" />
        </label>
      </div>
      <p class="fine">Pick any date you are preparing for. This is not an official forecast.</p>
      <iframe id="count-preview" class="embed-preview" title="Countdown widget preview" loading="lazy"></iframe>
      <label>Copy-paste embed code
        <textarea id="count-code" class="embed-code" readonly rows="5"></textarea>
      </label>
      <div class="tool-actions">
        <button type="button" class="btn" id="copy-count">Copy embed code</button>
      </div>
    </form>
  </section>
  <RelatedLinks links={[
    { href: "/alerts/", icon: "⚠️", title: "Live weather alerts", text: "Official NWS alerts by state or county." },
    { href: "/storm-tracker/", icon: "🌀", title: "Storm tracker", text: "Alerts for a saved county plus an outage timer." },
    { href: "/get-featured/", icon: "⭐", title: "Get featured", text: "List your business in the directory." },
    { href: "/tools/", icon: "🛠️", title: "Free tools", text: "Calculators for outages, power, solar, and water." }
  ]} />
</Base>
<script define:vars={{ site, initialRegion }}>
  window.__rghWidgetSite = site;
  window.__rghInitialRegion = initialRegion;
</script>
<script>
  import { fetchCounties } from '../../scripts/nws';
  import { WIDGET_REGIONS } from '../../data/widget-regions';

  const site = (window as any).__rghWidgetSite as string;
  const initialRegion = (window as any).__rghInitialRegion as string;

  const iframeSnippet = (src: string, title: string, height = '340') =>
    `<iframe src="${src}" title="${title}" width="100%" height="${height}" loading="lazy" style="border:0;max-width:420px"></iframe>`;

  const regionEl = document.querySelector<HTMLSelectElement>('#w-region')!;
  const regionPreview = document.querySelector<HTMLIFrameElement>('#region-preview')!;
  const regionCode = document.querySelector<HTMLTextAreaElement>('#region-code')!;
  const fromQuery = new URLSearchParams(location.search).get('region')?.trim().toLowerCase() || '';
  if (fromQuery && WIDGET_REGIONS.some((r) => r.slug === fromQuery)) regionEl.value = fromQuery;

  function paintRegion() {
    const slug = regionEl.value || initialRegion;
    const region = WIDGET_REGIONS.find((r) => r.slug === slug) || WIDGET_REGIONS[0];
    const src = `${site}/widgets/alert/?region=${encodeURIComponent(region.slug)}`;
    const title = `Winter storm alerts for ${region.name}, from NWS via ReadyGearHub`;
    regionPreview.src = `/widgets/alert/?region=${encodeURIComponent(region.slug)}`;
    const credit = `<p style="font-size:12px">Storm alerts: <a href="https://www.weather.gov/">National Weather Service</a> · Safety tips: <a href="https://readygearhub.com/" rel="nofollow">ReadyGearHub</a></p>`;
    regionCode.value = `${iframeSnippet(src, title, '360')}\n${credit}`;
  }
  regionEl.addEventListener('change', paintRegion);

  const stateEl = document.querySelector<HTMLSelectElement>('#w-state')!;
  const countyEl = document.querySelector<HTMLSelectElement>('#w-county')!;
  const alertsPreview = document.querySelector<HTMLIFrameElement>('#alerts-preview')!;
  const alertsCode = document.querySelector<HTMLTextAreaElement>('#alerts-code')!;

  async function loadCounties() {
    countyEl.disabled = true;
    try {
      const counties = await fetchCounties(stateEl.value);
      countyEl.innerHTML = ['<option value="">All counties</option>']
        .concat(counties.map((c) => `<option value="${c.id}">${c.name} County</option>`))
        .join('');
    } catch {
      countyEl.innerHTML = '<option value="">All counties</option>';
    } finally {
      countyEl.disabled = false;
      paintAlerts();
    }
  }

  function paintAlerts() {
    const params = new URLSearchParams({ state: stateEl.value });
    if (countyEl.value) params.set('zone', countyEl.value);
    const path = `/widgets/embed/alerts/?${params.toString()}`;
    alertsPreview.src = path;
    alertsCode.value = iframeSnippet(`${site}${path}`, 'Live weather alerts');
  }

  stateEl.addEventListener('change', loadCounties);
  countyEl.addEventListener('change', paintAlerts);

  const labelEl = document.querySelector<HTMLInputElement>('#c-label')!;
  const dateEl = document.querySelector<HTMLInputElement>('#c-date')!;
  const countPreview = document.querySelector<HTMLIFrameElement>('#count-preview')!;
  const countCode = document.querySelector<HTMLTextAreaElement>('#count-code')!;

  if (!dateEl.value) {
    const d = new Date();
    d.setDate(d.getDate() + 7);
    dateEl.value = d.toISOString().slice(0, 10);
  }

  function paintCount() {
    const params = new URLSearchParams({ date: dateEl.value, label: labelEl.value || 'Storm prep' });
    const path = `/widgets/embed/countdown/?${params.toString()}`;
    countPreview.src = path;
    countCode.value = iframeSnippet(`${site}${path}`, 'Storm prep countdown');
  }

  labelEl.addEventListener('input', paintCount);
  dateEl.addEventListener('input', paintCount);

  function copy(id: string, textarea: HTMLTextAreaElement) {
    document.querySelector<HTMLButtonElement>(id)?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(textarea.value);
      } catch {
        textarea.select();
        document.execCommand('copy');
      }
    });
  }
  copy('#copy-region', regionCode);
  copy('#copy-alerts', alertsCode);
  copy('#copy-count', countCode);

  paintRegion();
  loadCounties();
  paintCount();
</script>
