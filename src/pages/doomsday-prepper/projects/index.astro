---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Photo from '../../../components/Photo.astro';
import LeadCta from '../../../components/LeadCta.astro';
import Disclosure from '../../../components/Disclosure.astro';
import { doomsdayProjects } from '../../../data/doomsday-projects';
import { programs, resolveOutbound } from '../../../data/affiliates';
// Cost citations that point at Angi use the Angi program: plain until it is approved, then the tracked link
// (rel=sponsored, data-program) with no page edits. A fixed link without {url} would send every citation to one
// page, so those stay plain; the program then needs a deep-link template (or none, for CJ's deep-link form).
const angi = programs.find((p) => p.id === 'angi');
const cite = (url: string) => {
  if (!/^https:\/\/(www\.)?angi\.com\//.test(url)) return { href: url, affiliate: false, programId: '' };
  const o = resolveOutbound('angi', url);
  return o.affiliate && angi?.link && !angi.link.includes('{url}') ? { href: url, affiliate: false, programId: '' } : o;
};
const anyTracked = doomsdayProjects.some((p) => p.costs.some((c) => c.sourceUrl && cite(c.sourceUrl).affiliate));
const title = 'Doomsday Prepper Projects: Permits, Beginner Guides & Costs | ReadyGearHub';
const description = 'Permits and approvals, beginner guides and sourced cost ranges for bunkers, security fencing and gates, wells, septic, solar and generator hookups, outbuildings, safe rooms and excavation. Rules vary by county.';
const schema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'Doomsday Prepper projects: permits, beginner guides and costs', description, inLanguage: 'en-US', dateModified: '2026-11-25', author: { '@type': 'Organization', name: 'ReadyGearHub' } };
---
<Base title={title} description={description} schema={schema} pageClass="dir-doomsday">
  <PageHero title="Projects: permits, guides and costs" eyebrow="Doomsday Prepper" lead="Plan the big builds before you buy the gear. Each project has the approvals you will likely need, a beginner guide, and cost ranges with the source beside every figure." photo="hero-bunker-hatch" crumbs={[{ href: '/doomsday-prepper/', label: 'Doomsday Prepper' }, { label: 'Projects' }]} />
  <section class="wrap section pj">
    <aside class="pj-note">
      <p><strong>Rules vary by county and state.</strong> Permit requirements, fees and timelines are set locally. We link to the official sources and to published guides, and we do not summarize your local law for you. Call your county or city building department first. HOA covenants add their own rules.</p>
      <p><strong>About the numbers.</strong> Every dollar figure below comes from a page we link next to it, dated 2026. Cost guides are national averages and ranges, not quotes. Where we found no published figure, we say so instead of guessing.</p>
      <p><strong>Call 811 before any digging.</strong> It is free, and wait times vary by state. <a href="https://call811.com/" rel="noopener" target="_blank">call811.com</a></p>
      {anyTracked && <Disclosure onDark />}
    </aside>
    <nav class="pj-jump" aria-label="Projects">
      {doomsdayProjects.map((p) => <a class="pill" href={`#${p.id}`}>{p.name}</a>)}
      <a class="pill" href="#installers">Find an installer</a>
    </nav>

    {doomsdayProjects.map((p) => (
      <article class="pj-card" id={p.id}>
        <div class="pj-visual">
          <Photo name={p.photo} sizes="(max-width: 699px) 100vw, 640px" alt="" />
        </div>
        <h2>{p.name}</h2>
        <p>{p.intro}</p>

        <h3>Permits and approvals you will likely meet</h3>
        <ul>{p.approvals.map((a) => <li>{a}</li>)}</ul>
        <h3>Official and reference sources</h3>
        <ul class="pj-sources">
          {p.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a>{s.note ? <span class="fine"> · {s.note}</span> : null}</li>)}
        </ul>

        <h3>Beginner guide</h3>
        <div class="pj-guide">
          <div><h4>Plan</h4><ul>{p.guide.planning.map((g) => <li>{g}</li>)}</ul></div>
          <div><h4>Site checks</h4><ul>{p.guide.siteChecks.map((g) => <li>{g}</li>)}</ul></div>
          <div><h4>Hire or DIY</h4><p>{p.guide.hireVsDiy}</p><h4>Timeline</h4><p>{p.guide.timeline}</p></div>
        </div>

        <h3>Cost ranges, small to large</h3>
        <div class="pj-table-wrap">
          <table class="pj-table">
            <thead><tr><th>Size</th><th>What it covers</th><th>Published range</th><th>Source</th></tr></thead>
            <tbody>
              {p.costs.map((c) => (
                <tr>
                  <td>{c.size}</td>
                  <td>{c.what}{c.note ? <span class="fine pj-note-in"><br />{c.note}</span> : null}</td>
                  <td>{c.range ?? 'No published figure found'}</td>
                  <td>{c.sourceUrl ? <a href={cite(c.sourceUrl).href} rel={cite(c.sourceUrl).affiliate ? 'sponsored nofollow noopener' : 'noopener'} data-program={cite(c.sourceUrl).programId || undefined} target="_blank">{c.sourceLabel}</a> : 'None cited'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine">National planning figures from the linked pages, checked Nov 25, 2026. Your quote will differ.</p>
        <LeadCta place={`project:${p.id}`} max={4} inline />
      </article>
    ))}

    <section class="pj-card" id="installers">
      <h2>Looking for an installer or contractor?</h2>
      <p>Bigger builds need licensed local pros: excavation, fence and gate crews, drillers, septic installers, electricians and shelter dealers. We are putting together a vetted list by project type and county.</p>
      <p>Tell us the project, your county and your timeline, and we will note your interest. There is no cost to you and no obligation. We are not a contractor, and if we later earn a referral fee from an installer we will say so on this page.</p>
      <p><a class="btn" href="/contact/?topic=installer-leads">Tell us about your project</a></p>
    </section>
    <p class="fine"><a href="/doomsday-prepper/">← Doomsday Prepper</a> · <a href="/directory/doomsday-prepper/">All Doomsday Prepper listings</a> · <a href="/affiliate-disclosure/">Affiliate disclosure</a></p>
  </section>
</Base>
<style is:global>
  .pj-note{border-left:4px solid var(--amber);background:rgba(7,21,32,.55);color:var(--on-dark);padding:12px 18px;border-radius:4px;margin-bottom:20px}
  .pj-note a{color:var(--link-on-dark)}
  .pj-note p{margin:.4rem 0}
  .pj-jump{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 24px}
  .pj-jump .pill{text-decoration:none}
  .pj-card{border:1px solid var(--line);border-top:4px solid var(--navy);border-radius:var(--radius);padding:0 22px 20px;margin:0 0 28px;background:var(--card);color:var(--c-ink);scroll-margin-top:90px;overflow:hidden}
  .pj-visual{margin:0 -22px 16px;aspect-ratio:16/7;overflow:hidden;background:var(--storm-800)}
  .pj-visual img{width:100%;height:100%;object-fit:cover;display:block}
  .pj-card h2{margin-top:16px;color:var(--navy)}
  .pj-card h3{margin:22px 0 6px;border-bottom:1px solid #b08d3c;padding-bottom:4px;color:#14233a}
  .pj-card h4{margin:8px 0 4px;color:#14233a}
  .pj-guide{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
  .pj-sources li{margin:.25rem 0}
  .pj-table-wrap{overflow-x:auto}
  .pj-table{width:100%;border-collapse:collapse;font-size:.93rem}
  .pj-table th,.pj-table td{border:1px solid var(--line);padding:8px 10px;text-align:left;vertical-align:top}
  .pj-table th{background:#14233a;color:#f1e7c8}
  .pj-note-in{display:inline}
</style>
