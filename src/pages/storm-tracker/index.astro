---
// Standalone app shell: assets live under /storm-tracker/ so the service worker
// can stay scoped to this path and will not intercept the rest of the site.
const title = 'Storm Tracker | ReadyGearHub';
const description = 'Official National Weather Service alerts for a saved county, plus a fridge outage timer and a short Ready.gov checklist. Works offline with the last cached alerts.';
const canonical = new URL('/storm-tracker/', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0f2a3d" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="manifest" href="/storm-tracker/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/storm-tracker/icon-192.png" />
  <link rel="stylesheet" href="/storm-tracker/app.css" />
</head>
<body>
  <header class="app-bar">
    <div class="wrap">
      <a href="https://readygearhub.com/">Ready<span>Gear</span>Hub</a>
      <p class="sub">Storm Tracker</p>
    </div>
  </header>
  <main>
    <div class="wrap">
      <h1>Storm Tracker</h1>
      <aside class="disclaimer" role="note">
        <p><strong>Not a replacement for official alerts.</strong> Data from the National Weather Service. In an emergency, call 911. Official alerts come first — enable Wireless Emergency Alerts and a <a href="https://www.weather.gov/nwr/">NOAA Weather Radio</a>.</p>
      </aside>
      <div class="tabs" role="tablist" aria-label="Storm Tracker sections">
        <button type="button" role="tab" aria-selected="true" aria-controls="panel-alerts" id="tab-alerts">Alerts</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-timer" id="tab-timer">Outage timer</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="panel-kit" id="tab-kit">Checklist</button>
      </div>

      <section id="panel-alerts" role="tabpanel" aria-labelledby="tab-alerts">
        <div class="card">
          <div class="row row-2">
            <label>State
              <select id="st-state"></select>
            </label>
            <label>County
              <select id="st-county"><option value="">All counties</option></select>
            </label>
          </div>
          <div class="actions">
            <button type="button" class="btn" id="refresh">Refresh alerts</button>
          </div>
          <p class="fine">Your county is saved on this device. Alerts refresh every 5 minutes while the app is open.</p>
        </div>
        <div id="pro-locations" hidden class="card">
          <p>Pro multi-location tracking is not enabled yet.</p>
        </div>
        <div id="offline-flag" class="offline-flag" hidden></div>
        <div id="alerts-status" class="status loading">Loading official alerts from the National Weather Service…</div>
        <div id="alerts-out"></div>
      </section>

      <section id="panel-timer" role="tabpanel" aria-labelledby="tab-timer" hidden>
        <p>Countdown windows come from <a href="https://www.foodsafety.gov/keep-food-safe/food-safety-in-disaster-or-emergency">FoodSafety.gov</a>: about 4 hours for an unopened refrigerator, about 48 hours for a full freezer, and about 24 hours if the freezer is half full. When in doubt, throw it out. Food at or above 40°F for too long may not be safe.</p>
        <div class="card">
          <label>When did the power go out?
            <input type="datetime-local" id="outage-start" />
          </label>
          <button type="button" class="btn ghost" id="outage-now">Power just went out</button>
        </div>
        <div class="card" id="t-fridge"><h2>Refrigerator (~4 hours)</h2><p class="time">—</p></div>
        <div class="card" id="t-full"><h2>Full freezer (~48 hours)</h2><p class="time">—</p></div>
        <div class="card" id="t-half"><h2>Half-full freezer (~24 hours)</h2><p class="time">—</p></div>
      </section>

      <section id="panel-kit" role="tabpanel" aria-labelledby="tab-kit" hidden>
        <p>A short offline checklist from <a href="https://www.ready.gov/kit">Ready.gov, Build A Kit</a>. For a custom printable list, use the <a href="/tools/kit-builder/">kit builder</a> when you have a connection.</p>
        <div class="card">
          <ul class="checklist" id="checklist"></ul>
        </div>
      </section>

      <footer class="app-foot">
        <p><a href="/">ReadyGearHub</a> · <a href="/alerts/">Full alerts page</a> · <a href="/apps/">Install help</a> · <a href="/privacy/">Privacy</a></p>
      </footer>
    </div>
  </main>
  <script type="module" src="/storm-tracker/app.js"></script>
</body>
</html>
