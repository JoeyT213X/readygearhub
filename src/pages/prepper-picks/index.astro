---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import SourceCard from '../../components/SourceCard.astro';
import { prepperLanes, resolvedPrepperPicks, prepperPickToCatalogItem } from '../../data/prepper-picks';

const picks = resolvedPrepperPicks();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: "Prepper’s Picks",
  description: 'A calm, practical list of water, food, power, lighting, radios, first aid, cooking, shelter, tools, sanitation, and document-kit items, from a 72-hour bag up through a longer pantry.',
  url: new URL('/prepper-picks/', Astro.site).href,
};
---
<Base
  title="Prepper’s Picks | ReadyGearHub"
  description="Gear many households already keep on hand for a 72-hour bag up through a longer, roughly 90-day pantry. Some links are partner links; others go to the official product or resource page. Prices live on the seller’s site."
  schema={schema}
>
  <PageHero
    title="Prepper’s Picks"
    eyebrow="72 hours to a longer pantry"
    lead="A practical list for a household that already thinks ahead: water, food, power, lighting, radios, first aid, cooking, shelter, tools, sanitation, and the documents you want on paper. Prices, stock, and terms live on the seller’s site."
    photo="gear-flatlay"
    crumbs={[{ label: "Prepper’s Picks" }]}
  />

  <section class="wrap section tight">
    <p class="disclosure"><strong>Affiliate disclosure:</strong> Some links on this page are affiliate links. If you buy or sign up through one, ReadyGearHub may earn a commission at no extra cost to you. We only use tracking links from programs we’re already approved for. Cards without a partner program go to the official product, category, or government page, with no tracking. We don’t invent prices or ratings; if we don’t already have a verified price, the card says “See price.” <a href="/affiliate-disclosure/">Full disclosure</a></p>
  </section>

  <section class="wrap section tight">
    <p class="fine">These {picks.length} picks are a starting list, not a complete kit and not medical, legal, or financial advice. Read official pages for current specs, and get training before you rely on first-aid gear.</p>
    <nav class="prepper-lanes" aria-label="Prepper’s Picks categories">
      {prepperLanes.map((lane) => (
        <a class="prepper-lane-chip" href={`#${lane.id}`}>{lane.name}</a>
      ))}
    </nav>
  </section>

  {prepperLanes.map((lane) => {
    const items = picks.filter((p) => p.lane === lane.id);
    return (
      <section class="wrap section tight" id={lane.id}>
        <SectionHead kicker="Prepper’s Picks" title={lane.name} intro={lane.blurb} />
        <div class="grid shop-grid source-grid">
          {items.map((pick) => <SourceCard item={prepperPickToCatalogItem(pick)} />)}
        </div>
      </section>
    );
  })}
</Base>
