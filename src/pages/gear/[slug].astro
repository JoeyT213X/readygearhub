---
import Base from '../../layouts/Base.astro';
import ItemCard from '../../components/ItemCard.astro';
import Disclosure from '../../components/Disclosure.astro';
import GuideCard from '../../components/GuideCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import { render } from 'astro:content';
import { getItems, laneBySlug, outUrl, isAffiliate, programIdForItem, getGuides } from '../../lib/data';
import { productPhotoFor, photoBackdropClass } from '../../data/product-photos';
export async function getStaticPaths() {
  const items = await getItems();
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const lane = laneBySlug(d.lane)!;
const extraLanes = d.alsoIn.map(laneBySlug).filter(Boolean);
const related = (await getItems()).filter((i) => i.id !== item.id && (i.data.lane === d.lane || i.data.alsoIn.includes(d.lane))).slice(0, 3);
const allGuides = await getGuides();
const guides = allGuides.filter((g) => g.data.relatedItems.includes(item.id));
// Always offer 3 guides: ones that mention this item, then guides in the same lane, then same season.
const moreGuides = [...guides, ...allGuides.filter((g) => !guides.includes(g) && g.data.lane === d.lane), ...allGuides.filter((g) => !guides.includes(g) && g.data.lane !== d.lane && g.data.season.some((s) => d.season.includes(s as any)))].slice(0, 3);
const url = new URL(`/gear/${item.id}/`, Astro.site).href;
// Editorial Article markup, not Product: we don't sell these items or publish prices/ratings.
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.name, description: d.description, url, about: { '@type': 'Thing', name: d.name, sameAs: d.officialUrl } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: lane.name, item: new URL(`/${lane.slug}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.name, item: url } ] },
];
const program = programIdForItem(item.id);
const photo = productPhotoFor({ id: item.id });
const backdrop = photo ? photoBackdropClass({ id: item.id, name: d.name, brand: d.brand, tags: d.tags }) : '';
const desc = `${d.description} See uses, lanes, and where to check the current price.`.slice(0, 300);
---
<Base title={`${d.name}: Uses & Where to Buy | ReadyGearHub`} description={desc} schema={schema} type="article">
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/gear/">Gear</a></li><li><a href={`/${lane.slug}/`}>{lane.name}</a></li><li><span aria-current="page">{d.name}</span></li></ol></nav>
      <h1>{d.name}</h1>
      <p class="brand light">by {d.brand}</p>
      <p class="lead">{d.description}</p>
      <Disclosure onDark />
      <div class="hero-actions">
        {guides[0] && <a class="btn ghost light" href={`/guides/${guides[0].id}/`}>Read the guide first</a>}
        <a class="btn" href={outUrl(item)} target="_blank" rel={isAffiliate(item) ? 'sponsored nofollow noopener' : 'noopener'} data-program={isAffiliate(item) && program ? program : undefined}>Check current price at {isAffiliate(item) ? 'retailer' : d.brand} ↗</a>
      </div>
    </div>
  </section>
  <section class="wrap section detail">
    <div class="detail-main">
      {photo && (
        <figure class={`gear-official-photo ${backdrop}`}>
          <div class="photo-stage">
            <img src={photo.src} srcset={photo.srcset} sizes="(min-width: 800px) 640px, 92vw" alt={photo.alt} width="960" height="540" decoding="async" />
          </div>
          <figcaption>Official product photo from the brand’s affiliate-network catalog or product feed.</figcaption>
        </figure>
      )}
      {d.uses.length > 0 && (<><h2>Multi-purpose uses</h2><ul class="uses-list">{d.uses.map((u) => <li>{u}</li>)}</ul></>)}
      <h2>Why it's on the list</h2>
      <div class="prose"><Content /></div>
      <p class="fine">We don't list prices, specs that change, or star ratings. Always check the manufacturer's page for current details and safety instructions.{d.verified && ` Official link last checked ${d.verified}.`}</p>
    </div>
    <aside class="detail-side card">
      <p><strong>Lane:</strong> <a href={`/${lane.slug}/`}>{lane.icon} {lane.name}</a></p>
      {extraLanes.length > 0 && <p><strong>Also in:</strong> {extraLanes.map((l, i) => <>{i > 0 && ', '}<a href={`/${l!.slug}/`}>{l!.name}</a></>)}</p>}
      <p><strong>Season:</strong> {d.season.join(', ')}</p>
      {d.tags.length > 0 && <ul class="chip-list">{d.tags.map((t) => <li><span class="pill">{t}</span></li>)}</ul>}
      <a class="btn small" href={d.officialUrl} target="_blank" rel="noopener">Official product page ↗</a>
    </aside>
  </section>
  {moreGuides.length > 0 && (
    <section class="band"><div class="wrap section">
      <SectionHead kicker={guides.length ? 'Mentioned in' : 'Related reading'} title={guides.length ? 'Guides that mention this pick' : `Guides for ${lane.name.toLowerCase()}`} href="/guides/" linkLabel="All guides" />
      <div class="grid">{moreGuides.map((g) => <GuideCard guide={g} />)}</div>
    </div></section>
  )}
  {related.length > 0 && (<section class="wrap section"><SectionHead kicker="Same lane" title={`More in ${lane.name}`} href={`/${lane.slug}/`} linkLabel={`All ${lane.name}`} /><div class="grid">{related.map((r) => <ItemCard item={r} />)}</div></section>)}
</Base>
