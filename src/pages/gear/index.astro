---
import Base from '../../layouts/Base.astro';
import ItemCard from '../../components/ItemCard.astro';
import Disclosure from '../../components/Disclosure.astro';
import { getItems } from '../../lib/data';
const items = await getItems();
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'All gear', numberOfItems: items.length,
  itemListElement: items.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/gear/${t.id}/`, Astro.site).href, name: t.data.name })) };
---
<Base title="All Gear: Full Preparedness & Multi-Purpose Gear Directory | ReadyGearHub" description={`Browse all ${items.length} hand-picked survival, winter storm, power outage, off-grid, and multi-purpose gear listings on ReadyGearHub.`} schema={schema}>
  <section class="page-hero"><div class="wrap"><nav class="crumbs"><a href="/">Home</a> › All gear</nav><h1>All gear</h1><p class="lead">Every listing in the directory, trending picks first.</p></div></section>
  <section class="wrap section"><Disclosure /><div class="grid">{items.map((item) => <ItemCard item={item} showRank />)}</div></section>
</Base>
