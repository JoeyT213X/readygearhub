---
import NameCover from '../../components/NameCover.astro';
import { entryImageFor } from '../../data/card-image';
import Base from '../../layouts/Base.astro';
import ItemCard from '../../components/ItemCard.astro';
import PageHero from '../../components/PageHero.astro';
import LaneCard from '../../components/LaneCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import Disclosure from '../../components/Disclosure.astro';
import { lanes, getGuides } from '../../lib/data';
import { getItems } from '../../lib/data';
import { categories, entries, categoryForItem, resolveEntry } from '../../data/directory';
import { isNoPpcProgram } from '../../data/affiliates';
const items = await getItems();
const guides = (await getGuides()).slice(0, 3);
const laneCounts = Object.fromEntries(lanes.map((l) => [l.slug, items.filter((i) => i.data.lane === l.slug || i.data.alsoIn.includes(l.slug)).length]));
const resolved = entries.map(resolveEntry);
const total = items.length + resolved.length;
const groups = categories.map((c) => ({
  ...c,
  items: items.filter((i) => categoryForItem(i.id) === c.id),
  entries: resolved.filter((e) => e.category === c.id),
}));
const schema = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'ReadyGearHub preparedness directory', numberOfItems: items.length,
  itemListElement: items.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/gear/${t.id}/`, Astro.site).href, name: t.data.name })) };
---
<Base title="Preparedness Directory: Gear, Brands, Services & Free Resources | ReadyGearHub" description={`Browse ${total} preparedness listings by category: power, water, food, first aid, lighting, radios, offline entertainment, home protection, insurance and digital safety, plus free government resources.`} schema={schema}>
  <PageHero title="Preparedness gear directory" lead="Gear listings, brands, services and free official resources, sorted by category. Free resources from NWS, FEMA, Ready.gov and MEMA are marked as such." photo="gear-flatlay" crumbs={[{ label: 'Gear directory' }]}>
    <ul class="hero-quick"><li><a href="#lanes">🧭 Shop by lane</a></li><li><a href="#categories">📚 Browse categories</a></li><li><a href="/gear/tech/">🔋 Newest prep tech</a></li><li><a href="/kits/">🧰 Storm kits</a></li></ul>
  </PageHero>
  <section class="band" id="lanes">
    <div class="wrap section tight">
      <SectionHead kicker="Gear by lane" title="Shop by lane" intro="Each lane is a short, hand-picked list for one situation, with the guides that go with it." />
      <div class="grid lanes">{lanes.map((l) => <LaneCard lane={l} count={laneCounts[l.slug]} compact />)}</div>
    </div>
  </section>
  <section class="wrap section tight">
    <SectionHead kicker="Not sure what you need?" title="Read a guide first" href="/guides/" linkLabel="All guides" />
    <div class="grid">{guides.map((g) => <GuideCard guide={g} />)}</div>
  </section>
  <section class="wrap section" id="categories">
    <SectionHead kicker="Directory" title="Browse by category" />
    <Disclosure />
    <nav class="dir-nav" aria-label="Directory categories">
      {groups.map((g) => <a class="pill" href={`#${g.id}`}>{g.icon} {g.name} ({g.items.length + g.entries.length})</a>)}
    </nav>
    <p class="alert-callout" style="margin:0 0 18px"><span><strong>Looking for a shopping catalog?</strong> The <a href="/directory/">Full Source Directory</a> lists trending items and partner stores we already work with — tech, power, home, water, and our own downloads — plus partners still on the way.</span></p>
    <p class="fine">{total} listings: {items.length} gear listings with detail pages and {resolved.length} brands, services and resources. For current portable power, home backup batteries, satellite messengers, weather radios, water filters, and smart sensors, see <a href="/gear/tech/">newest prep tech</a>. For downloaded music and audiobooks, battery-powered speakers, and card games or comics that need no power, see <a href="#offline-entertainment">offline entertainment</a>.</p>

    {groups.map((g) => (
      <section id={g.id} class="dir-section">
        <h2>{g.icon} {g.name}</h2>
        <p>{g.blurb}</p>
        {g.note && <p class="fine"><strong>Note:</strong> {g.note}</p>}
        {g.items.length > 0 && (<>
          <h3>Gear listings</h3>
          <div class="grid">{g.items.map((item) => <ItemCard item={item} showRank />)}</div>
        </>)}
        {g.entries.length > 0 && (<>
          <h3>Brands, services &amp; resources</h3>
          <div class="grid">
            {g.entries.map((e) => (
              <article class="card item-card" data-chw={(e.programId === 'choice-home-warranty' || e.id === 'choice-home-warranty') ? '' : undefined} data-no-ppc={(isNoPpcProgram(e.programId) || isNoPpcProgram(e.id) || isNoPpcProgram(e.program)) ? '' : undefined}>
                {(() => { const img = entryImageFor(e); return img ? (
                  <span class="item-card-photo is-stock" aria-hidden="true">
                    <img src={img.src} srcset={img.srcset} sizes="(min-width: 900px) 360px, 92vw" alt="" width="960" height="540" loading="lazy" decoding="async" />
                    <span class="stock-chip">Representative photo</span>
                  </span>
                ) : <NameCover kicker={e.type} title={e.name} />; })()}
                <div class="card-top">
                  <span class="pill">{e.type}</span>
                  {e.affiliate && <span class="pill feat">Affiliate link</span>}
                </div>
                <h3>{e.name}</h3>
                <p>{e.desc}</p>
                <p class="uses"><strong>Offer:</strong> {e.offer}</p>
                <div class="card-actions">
                  <a class="btn small" href={e.href} target="_blank"
                     rel={e.affiliate ? 'sponsored nofollow noopener' : 'noopener'}
                     data-program={e.affiliate ? e.programId : undefined}>{e.cta ?? (e.type === 'Free resource' ? 'Visit official site ↗' : 'Visit site ↗')}</a>
                </div>
              </article>
            ))}
          </div>
        </>)}
      </section>
    ))}
    <p class="fine">Links go to third-party sites we do not control. Check the provider for current terms. Preparedness and medical information here is general and is not professional advice.</p>
  </section>
</Base>
<style>
  .dir-nav{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
  .dir-section{margin-top:36px;scroll-margin-top:80px}
  .dir-section h3{margin-top:22px}
</style>
