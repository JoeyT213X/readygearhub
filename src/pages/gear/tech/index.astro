---
import { entryImageFor } from '../../../data/card-image';
import Base from '../../../layouts/Base.astro';
import ItemCard from '../../../components/ItemCard.astro';
import Disclosure from '../../../components/Disclosure.astro';
import { getItems } from '../../../lib/data';
import { techGroups, entries, resolveEntry, techGroupForItem } from '../../../data/directory';
import { isNoPpcProgram } from '../../../data/affiliates';
const items = (await getItems()).filter((i) => techGroupForItem(i.id));
const resolved = entries.filter((e) => e.tech).map(resolveEntry);
const total = items.length + resolved.length;
const groups = techGroups.map((c) => ({
  ...c,
  items: items.filter((i) => techGroupForItem(i.id) === c.id),
  entries: resolved.filter((e) => e.tech === c.id),
}));
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ReadyGearHub newest prep tech',
  numberOfItems: total,
  itemListElement: [
    ...items.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/gear/${t.id}/`, Astro.site).href, name: t.data.name })),
    ...resolved.map((e, i) => ({ '@type': 'ListItem', position: items.length + i + 1, url: e.url, name: e.name })),
  ],
};
---
<Base title="Newest Prep Tech: Power, Satellite, Radios, Water & Sensors | ReadyGearHub" description={`Current portable energy reserves and solar, home backup batteries, satellite messengers, NOAA weather radios, water filters, and smart leak, freeze, and smoke/CO sensors. ${total} listings with official manufacturer links. No prices or ratings.`} schema={schema}>
  <section class="page-hero"><div class="wrap">
    <nav class="crumbs"><a href="/">Home</a> › <a href="/gear/">Directory</a> › Newest tech</nav>
    <h1>Newest prep tech</h1>
    <p class="lead">Newer prep gear is less about gadgets for their own sake and more about keeping power, water, alerts, and a way to call for help when a storm or outage knocks out the usual systems. This section gathers current portable energy reserves and solar, home backup batteries, satellite messengers, NOAA weather radios, water filters and purifiers, and smart leak, freeze, and smoke/CO sensors.</p>
  </div></section>
  <section class="wrap section">
    <Disclosure />
    <nav class="dir-nav" aria-label="Newest tech groups">
      {groups.map((g) => <a class="pill" href={`#${g.id}`}>{g.icon} {g.name} ({g.items.length + g.entries.length})</a>)}
    </nav>
    <p class="fine">{total} listings: {items.length} with detail pages and {resolved.length} official product pages. Listings use official manufacturer links. Some devices need a paid subscription, a hub, or professional installation &mdash; each card says what the offer is.</p>

    {groups.map((g) => (
      <section id={g.id} class="dir-section">
        <h2>{g.icon} {g.name}</h2>
        <p>{g.blurb}</p>
        {g.note && <p class="fine"><strong>Note:</strong> {g.note}</p>}
        {g.items.length > 0 && (<>
          <h3>Gear listings</h3>
          <div class="grid">{g.items.map((item) => <ItemCard item={item} />)}</div>
        </>)}
        {g.entries.length > 0 && (<>
          <h3>{g.items.length > 0 ? 'More official pages' : 'Official product pages'}</h3>
          <div class="grid">
            {g.entries.map((e) => (
              <article class="card item-card" data-no-ppc={(isNoPpcProgram(e.programId) || isNoPpcProgram(e.id) || isNoPpcProgram(e.program)) ? '' : undefined}>
                {(() => { const img = entryImageFor(e); return img && (
                  <span class="item-card-photo is-stock" aria-hidden="true">
                    <img src={img.src} srcset={img.srcset} sizes="(min-width: 900px) 360px, 92vw" alt="" width="960" height="540" loading="lazy" decoding="async" />
                    <span class="stock-chip">Representative photo</span>
                  </span>
                ); })()}
                <div class="card-top">
                  <span class="pill">{e.type}</span>
                  {e.affiliate && <span class="pill feat">Affiliate link</span>}
                </div>
                <h3>{e.name}</h3>
                <p>{e.desc}</p>
                <p class="uses"><strong>Offer:</strong> {e.offer}</p>
                <div class="card-actions">
                  {e.url ? (
                    <a class="btn small" href={e.href} target="_blank"
                       rel={e.affiliate ? 'sponsored nofollow noopener' : 'noopener'}
                       data-program={e.affiliate ? e.programId : undefined}>{e.cta ?? (e.type === 'Free resource' ? 'Visit official site ↗' : 'Visit official page ↗')}</a>
                  ) : (
                    <span class="pill">Coming soon</span>
                  )}
                </div>
              </article>
            ))}
          </div>
        </>)}
      </section>
    ))}
    <p class="fine">Links go to third-party sites we do not control. Check the provider for current terms, specs, and safety instructions. Preparedness and medical information here is general and is not professional advice. <a href="/gear/">Back to the full directory</a></p>
  </section>
</Base>
<style>
  .dir-nav{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0}
  .dir-section{margin-top:36px;scroll-margin-top:80px}
  .dir-section h3{margin-top:22px}
</style>
