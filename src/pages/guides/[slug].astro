---
import Base from '../../layouts/Base.astro';
import ItemCard from '../../components/ItemCard.astro';
import Disclosure from '../../components/Disclosure.astro';
import LeadCta from '../../components/LeadCta.astro';
import PageHero from '../../components/PageHero.astro';
import GuideCard from '../../components/GuideCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import Photo from '../../components/Photo.astro';
import GuideProducts from '../../components/GuideProducts.astro';
import { render } from 'astro:content';
import { getGuides, getItems, laneBySlug, site, isAffiliate } from '../../lib/data';
import { categoryBySlug } from '../../data/source-directory';
import { photoForGuide, photos } from '../../data/images';
import { CALCULATORS } from '../../lib/app-config';
import WinterDealsCallout from '../../components/WinterDealsCallout.astro';
import MailerLiteSignup from '../../components/MailerLiteSignup.astro';
import { guideNav, winterOptIn } from '../../data/guide-links';
import { sourceCategories } from '../../data/source-directory';
export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const d = guide.data;
const all = await getItems();
const related = d.relatedItems.map((id) => all.find((i) => i.id === id)).filter(Boolean) as typeof all;
const lane = d.lane ? laneBySlug(d.lane) : undefined;
const url = new URL(`/guides/${guide.id}/`, Astro.site).href;
const allGuides = await getGuides();
// Related guides: same lane, then shared gear, then same season; never the current guide.
const score = (g: typeof guide) => (g.data.lane && g.data.lane === d.lane ? 10 : 0) + g.data.relatedItems.filter((id) => d.relatedItems.includes(id)).length + (g.data.season.some((s) => d.season.includes(s)) ? 1 : 0);
const relatedGuides = allGuides.filter((g) => g.id !== guide.id).map((g) => ({ g, s: score(g) })).sort((a, b) => b.s - a.s).slice(0, 3).map((x) => x.g);
const nav = guideNav[guide.id] ?? {};
const readNext = (nav.readNext ?? []).map((id) => allGuides.find((g) => g.id === id)).filter(Boolean) as typeof allGuides;
const dirCats = (nav.directory ?? []).map((slug) => sourceCategories.find((c) => c.slug === slug)).filter(Boolean) as typeof sourceCategories;
const optIn = winterOptIn[guide.id];
const toc = headings.filter((h) => h.depth === 2);
// Products in this guide: picks on paid (tracked) links lead; the rest are listed as plain mentions with no outbound link.
const paidPicks = related.filter((r) => isAffiliate(r));
const otherPicks = related.filter((r) => !isAffiliate(r));
const dirByLane: Record<string, string> = {
  'winter-storm-prep': 'safety', 'power-outage-kits': 'power', 'vehicle-emergency-kits': 'auto', 'home-heating-backup': 'home',
  'cold-weather-gear': 'outdoor', 'off-grid-power': 'power', 'storm-hurricane-prep': 'safety', 'homestead-multi-purpose': 'food',
  'home-backup-power-solar': 'power', 'emergency-water': 'water', 'first-aid-medical-prep': 'safety',
};
const dirCat = categoryBySlug(d.directory ?? dirByLane[d.lane ?? ''] ?? 'safety');
const siblingGuides = [
  ...d.siblings.map((id) => allGuides.find((g) => g.id === id)).filter(Boolean),
  ...relatedGuides,
].filter((g, i, arr) => g && arr.findIndex((x) => x!.id === g.id) === i).slice(0, 2) as typeof allGuides;
const photoKey = photoForGuide(guide.id, d.lane);
const toolByLane: Record<string, string> = {
  'power-outage-kits': '/tools/outage-timer/', 'home-backup-power-solar': '/tools/power-sizer/', 'off-grid-power': '/tools/solar-sizer/',
  'emergency-water': '/tools/water-calculator/', 'storm-hurricane-prep': '/tools/water-calculator/', 'winter-storm-prep': '/tools/kit-builder/',
  'home-heating-backup': '/tools/outage-timer/', 'vehicle-emergency-kits': '/tools/kit-builder/', 'first-aid-medical-prep': '/tools/kit-builder/',
};
const tool = CALCULATORS.find((c) => c.href === (toolByLane[d.lane ?? ''] ?? '/tools/kit-builder/'));
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, datePublished: d.published.toISOString(), dateModified: (d.updated ?? d.published).toISOString(),
    image: new URL(`/images/photos/${photoKey}-1600.webp`, Astro.site).href,
    mainEntityOfPage: url, author: { '@type': 'Organization', name: site.name, url: site.url }, publisher: { '@type': 'Organization', name: site.name, url: site.url } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
];
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={`${d.title} | ReadyGearHub`} description={d.description} schema={schema} type="article" footerSignup={!optIn}>
  <PageHero title={d.title} lead={d.description} crumbs={[{ href: '/guides/', label: 'Guides' }, ...(lane ? [{ href: `/${lane.slug}/`, label: lane.name }] : [])]}>
    <p class="meta-row">Updated {fmt(d.updated ?? d.published)}{lane && <> · <a href={`/${lane.slug}/`}>{lane.icon} {lane.name}</a></>}{related.length > 0 && <> · <a href="#gear">Products in this guide</a></>}</p>
  </PageHero>
  <div class="wrap section guide-layout">
    <article class="guide-main">
      {optIn && (
        <div class="no-print guide-optin">
          <MailerLiteSignup variant="card" form="stormReminders" heading={optIn.heading} intro={optIn.intro} note="A few calm emails a season, never daily. One-click unsubscribe." />
        </div>
      )}
      <figure class="guide-cover">
        <Photo name={photoKey} eager sizes="(min-width: 1024px) 760px, 100vw" />
        <figcaption>Photo: <a href={photos[photoKey].sourceUrl} rel="noopener" target="_blank">{photos[photoKey].author} on {(() => { try { const h = new URL(photos[photoKey].sourceUrl).hostname.replace(/^www\./, ''); return h.startsWith('pexels') ? 'Pexels' : h.startsWith('pixabay') ? 'Pixabay' : h.startsWith('unsplash') ? 'Unsplash' : h; } catch { return 'Unsplash'; } })()}</a></figcaption>
      </figure>
      <Disclosure />
      <div class="prose guide"><Content /></div>
    </article>
    <aside class="guide-aside" aria-label="Guide navigation">
      {toc.length > 2 && (
        <nav class="card toc" aria-label="In this guide">
          <p class="aside-h">In this guide</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <GuideProducts items={related} lane={lane} />
      {lane && (
        <div class="card">
          <p class="aside-h">{lane.icon} {lane.name}</p>
          <p class="fine" style="margin:.2em 0 .6em">{lane.summary}</p>
          <a class="btn small" href={`/${lane.slug}/`}>Browse the lane</a>
        </div>
      )}
      {tool && (
        <a class="card next-step" href={tool.href}><span class="ns-icon" aria-hidden="true">{tool.icon}</span><span><strong>{tool.name}</strong><span>{tool.blurb}</span></span></a>
      )}
    </aside>
  </div>
  <LeadCta place={guide.id} />
  <section class="wrap section" id="gear">
    <SectionHead kicker="Products in this guide" title="Products in this guide" intro="The picks we mention, each with a details page covering uses and safety notes, plus a link to check the current price." href={dirCat ? `/directory/${dirCat.slug}/` : '/directory/'} linkLabel={dirCat ? `Browse ${dirCat.name}` : 'Full directory'} />
    {paidPicks.length > 0 && <Disclosure />}
    {paidPicks.length > 0 && <div class="grid">{paidPicks.map((r) => <ItemCard item={r} showGuide={false} />)}</div>}
    {otherPicks.length > 0 && (
      <p class="fine guide-also">Also mentioned: {otherPicks.map((r, i) => <>{i > 0 && ' · '}<a href={`/gear/${r.id}/`}>{r.data.name}</a></>)}</p>
    )}
    <div class="guide-links card">
      {dirCat && <p><strong>Shop the category:</strong> <a href={`/directory/${dirCat.slug}/`}>{dirCat.name}</a> in the Full Source Directory.</p>}
      {siblingGuides.length > 0 && <p><strong>Read next:</strong> {siblingGuides.map((g, i) => <>{i > 0 && ' and '}<a href={`/guides/${g.id}/`}>{g.data.title}</a></>)}</p>}
    </div>
  </section>

  <section class="band">
    <div class="wrap section">
      <SectionHead kicker="Keep going" title="Related guides" href="/guides/" linkLabel="All guides" />
      <div class="grid">{relatedGuides.map((g) => <GuideCard guide={g} laneName={g.data.lane ? laneBySlug(g.data.lane)?.name : undefined} />)}</div>
      {(readNext.length > 0 || dirCats.length > 0 || (nav.extras ?? []).length > 0) && (
        <nav class="guide-more" aria-label="More on this topic" style="margin-top:28px">
          {readNext.length > 0 && (
            <>
              <h3>Go deeper</h3>
              <ul class="link-list">{readNext.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a></li>)}{(nav.extras ?? []).map((x) => <li><a href={x.href}>{x.label}</a></li>)}</ul>
            </>
          )}
          {readNext.length === 0 && (nav.extras ?? []).length > 0 && (
            <ul class="link-list">{(nav.extras ?? []).map((x) => <li><a href={x.href}>{x.label}</a></li>)}</ul>
          )}
          {dirCats.length > 0 && (
            <>
              <h3>Browse the Full Source Directory</h3>
              <ul class="dir-nav">{dirCats.map((c) => <li><a class="pill" href={`/directory/${c.slug}/`}>{c.name}</a></li>)}</ul>
            </>
          )}
        </nav>
      )}
      <h3 style="margin-top:28px">Next steps</h3>
      {d.season.includes('winter') && <WinterDealsCallout compact />}
      <div class="next-steps">
        <a class="card next-step" href="/alerts/"><span class="ns-icon" aria-hidden="true">⚠️</span><span><strong>Check live alerts</strong><span>Official NWS watches and warnings for your area.</span></span></a>
        <a class="card next-step" href="/tools/kit-builder/"><span class="ns-icon" aria-hidden="true">📋</span><span><strong>Build your kit list</strong><span>A printable Ready.gov checklist sized to your household.</span></span></a>
        <a class="card next-step" href="/winter-storm-ready-checklist/"><span class="ns-icon" aria-hidden="true">✅</span><span><strong>Free winter storm checklist</strong><span>A printable Ready.gov-based checklist, plus a calm email reminder if you want one.</span></span></a>
      </div>
    </div>
  </section>
</Base>
<style>
  .guide-also{margin-top:14px}
  .guide-links{margin-top:16px;padding:14px 18px}
  .guide-links p{margin:.3em 0}
</style>
