---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { kits } from '../../lib/kits';

const kitPhotos: Record<string, string> = {
  'car-winter-kit': 'car-in-snow',
  'apartment-outage-kit': 'outage-candle',
  'elderly-parent-kit': 'hero-snowy-home',
  'homestead-ice-storm-kit': 'storm-barn',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Storm kits',
  description: 'Curated winter storm and outage kits built from ReadyGearHub gear listings.',
  url: new URL('/kits/', Astro.site).href,
};
---
<Base title="Storm Kits: Car, Apartment, Elderly Parent & Homestead | ReadyGearHub" description="Four curated storm kits built only from ReadyGearHub listings: a winter car kit, an apartment outage kit, a kit for elderly parents, and a homestead ice-storm kit." schema={schema}>
  <PageHero
    title="Storm kits"
    photo="winter-storm-street"
    crumbs={[{ label: 'Storm kits' }]}
    lead="Four starting lineups for a winter storm, assembled only from gear already listed in the directory. There are no prices here — use each product page to check the current price and the manufacturer's instructions."
  />
  <section class="wrap section">
    <div class="grid">
      {kits.map((k) => (
        <a class="card kit-card" href={`/kits/${k.slug}/`}>
          {kitPhotos[k.slug] && (
            <span class="kit-card-img">
              <Photo name={kitPhotos[k.slug]} decorative sizes="(min-width: 980px) 33vw, (min-width: 640px) 50vw, 100vw" />
            </span>
          )}
          <span class="kit-card-body">
            <h3>{k.name}</h3>
            <p>{k.description}</p>
            <span class="count">{k.items.length} items →</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Base>
