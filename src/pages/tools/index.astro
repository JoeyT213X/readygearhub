---
import Base from '../../layouts/Base.astro';
import '../../styles/interactive.css';
import { CALCULATORS, OFFLINE_APPS } from '../../lib/app-config';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getGuides } from '../../lib/data';
const guideIds = ['generator-vs-energy-reserve', 'emergency-water-storage', 'winter-power-outage-checklist'];
const guides = (await getGuides()).filter((g) => guideIds.includes(g.id));
---
<Base title="Preparedness Tools | ReadyGearHub" description="Free, browser-based tools: live weather alerts, generator and solar sizers, a water storage calculator, a fridge and freezer outage timer, a Ready.gov kit builder, and six installable offline apps.">
  <PageHero title="Preparedness tools" lead="Simple calculators and official-alert lookups you can use in the browser, plus installable apps that work offline on this device. No invented sample data." photo="power-banks" crumbs={[{ label: 'Tools' }]} />
  <section class="wrap section">
    <SectionHead kicker="In your browser" title="Calculators & lookups" intro="Use these in the browser. Live alerts come from the National Weather Service." />
    <div class="tools-grid">
      <a class="card tool-card" href="/alerts/">
        <span class="lane-icon" aria-hidden="true">⚠️</span>
        <h3>Live weather alerts</h3>
        <p>Official National Weather Service alerts by state or county. Default view is Mississippi.</p>
        <span class="count">Open alerts →</span>
      </a>
      {CALCULATORS.map((tool) => (
        <a class="card tool-card" href={tool.href}>
          <span class="lane-icon" aria-hidden="true">{tool.icon}</span>
          <h3>{tool.name}</h3>
          <p>{tool.blurb}</p>
          <span class="count">{tool.cta}</span>
        </a>
      ))}
      <a class="card tool-card" href="/widgets/">
        <span class="lane-icon" aria-hidden="true">🔗</span>
        <h3>Embeddable widgets</h3>
        <p>Add a current-alerts badge or a storm-prep countdown to your own site with a copy-paste iframe.</p>
        <span class="count">Build a widget →</span>
      </a>
    </div>
  </section>
  <section class="wrap section">
    <SectionHead kicker="Works offline" title="Offline apps" intro="Six small, installable apps that keep working offline on this device." href="/apps/" linkLabel="See all apps" />
    <div class="tools-grid">
      {OFFLINE_APPS.map((app) => (
        <a class="card tool-card" href={app.href}>
          <span class="lane-icon" aria-hidden="true">{app.icon}</span>
          <h3>{app.name}</h3>
          <p>{app.blurb}</p>
          <span class="count">Open app →</span>
        </a>
      ))}
    </div>
  </section>
  <section class="band">
    <div class="wrap section">
      <SectionHead kicker="Pair with a guide" title="Guides that use these tools" href="/guides/" linkLabel="All guides" />
      <div class="grid">{guides.map((g) => <GuideCard guide={g} />)}</div>
    </div>
  </section>
</Base>
